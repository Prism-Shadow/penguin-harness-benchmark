# Every pattern is rooted on purpose: vendored task directories under
# benchmarks/*/tasks/ are copied verbatim and may legitimately contain files
# such as .env, *.key or *.pyc that a global pattern would silently drop.

# Harbor job output (trial logs, Penguin data roots with Traces). Never
# committed: the results PR carries summaries under results/ only.
/jobs/
/bundles/

# rag-bench-essential is fetched and converted locally at a pinned commit; its
# payloads stay under upstream terms and are not redistributed here.
/benchmarks/rag-bench-essential/upstream/
/benchmarks/rag-bench-essential/tasks/

# Upstream archives downloaded by tools/vendor_hub_tasks.py.
/.vendor-cache/

# Python caches and environments of the repository's own code.
/agents/**/__pycache__/
/tools/**/__pycache__/
/.venv/
