# Every pattern is rooted on purpose: vendored task directories under
# data/*/tasks/ are copied verbatim and may legitimately contain files
# such as .env, *.key or *.pyc that a global pattern would silently drop.

# Harbor job output (trial logs, Penguin data roots with Traces). Never
# committed: experiment records are stored under experiments/.
/jobs/
/bundles/

# Local source checkouts and downloaded archives.
/data/penguinharness-benchmark-sec-a/upstream/
/.vendor-cache/

# Python caches and environments of the repository's own code.
/agents/**/__pycache__/
/.venv/
