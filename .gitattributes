# Shell scripts and the Node helpers are executed inside Linux task containers; a CRLF
# checkout breaks them under /bin/sh (dash reads `set -eu\r` as an illegal option).
*.sh text eol=lf
*.mjs text eol=lf

# Text this repository authors and parses itself.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Deliberately not covered: the vendored task fixtures under data/*/tasks/ are copied
# verbatim from upstream projects and their bytes are part of the task, so no line-ending
# rule may rewrite them here.
