#!/bin/bash
set -euo pipefail
pg_isready -q -h 127.0.0.1
redis-cli ping | grep -q '^PONG$'
curl -fsS 'http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=2s' | python3 -c 'import json,sys; v=json.load(sys.stdin); assert v["status"] in ("yellow","green") and not v["timed_out"]'
chromium --version
cd /app/code
bundle check
bundle exec ruby -rexecjs -e 'abort "JavaScript runtime failed" unless ExecJS.eval("6 * 7") == 42; puts "ExecJS runtime: #{ExecJS.runtime.name}"'
printf 'PostgreSQL, Redis, Elasticsearch, Chromium, ExecJS and locked bundle are ready\n'
