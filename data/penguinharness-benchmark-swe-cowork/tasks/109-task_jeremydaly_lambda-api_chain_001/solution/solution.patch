+    this.multiValueQuery = Object.assign({},
+      this._multiValueSupport ? {} : Object.keys(this.query)
+        .reduce((qs,key) => Object.assign(qs, { [key]: [this.query[key]] }), {}),
+      this.app._event.multiValueQueryStringParameters)
