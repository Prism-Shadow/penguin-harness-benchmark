+    }
+
+    if (auto* const vehicleSA = dynamic_cast<CVehicleSA*>(vehicle))
+        vehicleSA->NoteModelSpecialAbilityHookResolve(currentModel, resolvedModel, false);
+    return resolvedModel;
+}
