@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+
+namespace MongoDB\Laravel\Eloquent;
+
+use Illuminate\Database\Eloquent\Model;
+
+use function method_exists;
+
+// This hook was introduced in Laravel 13. Override is only valid when the
+// installed parent actually declares it; both versions share the same body.
+if (method_exists(Model::class, 'initializeModelAttributes')) {
+    trait ModelAttributeInitialization
+    {
+        #[\Override]
+        public function initializeModelAttributes()
+        {
+            $this->initializeMongoDBModelAttributes();
+        }
+    }
+} else {
+    trait ModelAttributeInitialization
+    {
+        public function initializeModelAttributes()
+        {
+            $this->initializeMongoDBModelAttributes();
+        }
+    }
+}
