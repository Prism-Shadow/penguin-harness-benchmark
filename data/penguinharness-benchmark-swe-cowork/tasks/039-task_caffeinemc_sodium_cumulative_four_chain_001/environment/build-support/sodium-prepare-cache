#!/bin/sh
set -eu
cache="${GRADLE_USER_HOME:-/tmp/sodium-gradle-cache}"
mkdir -p "$cache"
if [ ! -f "$cache/.sodium-offline-ready" ]; then
    cp -a /opt/gradle-cache/. "$cache/"
    touch "$cache/.sodium-offline-ready"
fi
if [ ! -d .gradle ] && [ -f settings.gradle.kts ]; then
    cp -a /opt/project-gradle-cache .gradle
fi
