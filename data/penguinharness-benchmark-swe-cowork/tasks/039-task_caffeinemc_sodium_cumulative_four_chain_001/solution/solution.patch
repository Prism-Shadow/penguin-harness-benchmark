+    public static int renderIconWithSpacing(GuiGraphics graphics, ResourceLocation icon, int color, boolean iconMonochrome, int x, int y, int height, int margin) {
+        int iconSize = height - margin * 2;
+
+        var texture = Minecraft.getInstance().getTextureManager().getTexture(icon);
+        texture.bind();
+        int w = org.lwjgl.opengl.GL11.glGetTexLevelParameteri(org.lwjgl.opengl.GL11.GL_TEXTURE_2D, 0, org.lwjgl.opengl.GL11.GL_TEXTURE_WIDTH);
+        int h = org.lwjgl.opengl.GL11.glGetTexLevelParameteri(org.lwjgl.opengl.GL11.GL_TEXTURE_2D, 0, org.lwjgl.opengl.GL11.GL_TEXTURE_HEIGHT);
+
+        x = x + margin;
+        y = y + height / 2 - iconSize / 2;
+        if (iconMonochrome) {
+            graphics.blit(RenderType::guiTextured, icon, x, y, 0, 0, iconSize, iconSize, w, h, w, h, color);
+        } else {
+            graphics.blit(RenderType::guiTextured, icon, x, y, 0, 0, iconSize, iconSize, w, h, w, h);
+        }
+
+        return margin * 2 + iconSize;
+    }
