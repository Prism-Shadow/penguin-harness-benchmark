+                }
+                case GraphDirection.WEST -> {
+                    neighborIndex = currentIndex - DX;
+                    reachedFace = (neighborIndex & X_MASK) == X_MASK;
+                }
+                case GraphDirection.EAST -> {
+                    neighborIndex = currentIndex + DX;
+                    reachedFace = (neighborIndex & X_MASK) == 0;
+                }
