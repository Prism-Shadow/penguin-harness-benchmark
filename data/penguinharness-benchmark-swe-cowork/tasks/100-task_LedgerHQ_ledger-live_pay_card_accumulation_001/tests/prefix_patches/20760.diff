+  page: string;
+  onTrackEvent?: (event: string, params: Record<string, unknown>) => void;
+}>;
+
+export type ActionTilesViewProps = Readonly<{
+  tiles: readonly ActionTile[];
+}>;
diff --git a/features/flow/pay-card-balance/src/components/ActionTiles/useActionTilesViewModel.ts b/features/flow/pay-card-balance/src/components/ActionTiles/useActionTilesViewModel.ts
