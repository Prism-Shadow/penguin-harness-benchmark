+    refresh();
+    assert.doesNotMatch(text(renderer.root), /(^|[^0-9.])250([^0-9.]|$)/);
+    assert.ok(text(renderer.root).includes("payTab.balance.emptyTitle"));
+  } finally {
+    if (renderer) act(() => renderer.unmount());
+  }
+}
