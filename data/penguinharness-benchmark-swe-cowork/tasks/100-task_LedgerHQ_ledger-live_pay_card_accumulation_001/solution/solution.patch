+import { PAY_CARD_BALANCE_FILTER_ALL, type BalanceFilter } from "../state";
+
+export function resolveSelection(
+  persisted: BalanceFilter,
+  optionIds: readonly BalanceFilter[],
+): BalanceFilter {
+  if (optionIds.includes(persisted)) return persisted;
+  if (optionIds.includes(PAY_CARD_BALANCE_FILTER_ALL)) return PAY_CARD_BALANCE_FILTER_ALL;
+  return optionIds[0] ?? PAY_CARD_BALANCE_FILTER_ALL;
+}
