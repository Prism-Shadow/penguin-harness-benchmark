+    tag: &'static str,
+    variant_index: u32,
+    variant_name: &'static str,
+}
+
+impl AdjacentlyTaggedEnumVariantSerializer {
+    pub fn new(tag: &'static str, variant_index: u32, variant_name: &'static str) -> Self {
