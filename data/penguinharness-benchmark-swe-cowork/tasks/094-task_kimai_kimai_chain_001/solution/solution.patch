+}
+
+$avatarSizes: "xs" .75, "sm" 1.25, "md" 1.5, "lg" 2;
+
+@each $avatarSizeName, $avatarBaseSize in $avatarSizes {
+    .avatar-#{$avatarSizeName} {
+        width: ceil($avatar-base-size * $avatarBaseSize)+px;
