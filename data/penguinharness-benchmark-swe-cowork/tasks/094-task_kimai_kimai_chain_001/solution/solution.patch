+
+    /**
+     * @param ActivityBudgetStatisticModel[] $models
+     * @param \DateTime|null $begin
+     * @param \DateTime|null $end
+     */
+    public function __construct(array $models, ?\DateTime $begin = null, ?\DateTime $end = null)
+    {
+        $this->models = $models;
+        $this->begin = $begin;
+        $this->end = $end;
