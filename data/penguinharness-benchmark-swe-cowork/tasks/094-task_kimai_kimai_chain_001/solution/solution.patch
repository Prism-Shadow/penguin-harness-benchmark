diff --git a/assets/js/widgets/KimaiStorage.js b/assets/js/widgets/KimaiStorage.js
new file mode 100644
index 0000000..5927aa5
--- /dev/null
+++ b/assets/js/widgets/KimaiStorage.js
@@ -0,0 +1,30 @@
+/*
+ * This file is part of the Kimai time-tracking app.
+ *
+ * For the full copyright and license information, please view the LICENSE
+ * file that was distributed with this source code.
+ */
+
+/*!
+ * [KIMAI] KimaiStorage: simple wrapper to handle localStorage access
+ */
+
+export default class KimaiStorage {
+
+    static set(name, values) {
+        window.localStorage.setItem(name, JSON.stringify(values));
+    }
+
+    static get(name) {
+        let value = window.localStorage.getItem(name);
+        if (value === undefined || value === null) {
+            return null;
+        }
+        return JSON.parse(value);
+    }
+
+    static remove(name) {
+        window.localStorage.removeItem(name);
+    }
+
+}
