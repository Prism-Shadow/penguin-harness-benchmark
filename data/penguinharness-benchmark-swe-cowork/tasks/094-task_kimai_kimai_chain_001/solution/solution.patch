+        $new_configuration = ['a' => 'new_value'] + $configuration + ['e' => 'should_not_be_set'];
+        $sut->setConfiguration($new_configuration);
+
+        unset($new_configuration['e']);
+        self::assertSame($new_configuration, $sut->getConfiguration());
+    }
+}
