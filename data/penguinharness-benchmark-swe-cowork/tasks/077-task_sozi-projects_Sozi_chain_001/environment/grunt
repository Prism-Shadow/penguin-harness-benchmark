#!/usr/bin/env node
// Use the public grunt-cli bundled with the current repository's Grunt package.
const path = require('path');
const {createRequire} = require('module');
const project = createRequire(path.join(process.cwd(), 'package.json'));
const grunt = createRequire(project.resolve('grunt/package.json'));
grunt('grunt-cli/bin/grunt');
