+    A4         : {width: 297,   height: 210}, // mm
+    B4ISO      : {width: 353,   height: 250}, // mm
+    B4JIS      : {width: 364,   height: 257}, // mm
+    B5ISO      : {width: 250,   height: 176}, // mm
+    B5JIS      : {width: 257,   height: 182}, // mm
