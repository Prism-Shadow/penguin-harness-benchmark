+    querySelectorAll: () => [],
+    getElementById: () => domNode('div'),
+    documentElement: domNode('html'),
+  };
+  const local = new Map();
+  global.localStorage = {
+    getItem(key) { return local.has(key) ? local.get(key) : null; },
