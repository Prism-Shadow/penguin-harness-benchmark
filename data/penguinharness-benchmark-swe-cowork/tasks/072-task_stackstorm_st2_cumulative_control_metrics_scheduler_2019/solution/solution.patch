index 0000000000000000000000000000000000000000..b3a33eb35c829ee166205704e9db41f00510c130
--- /dev/null
+++ b/st2common/st2common/services/inquiry.py
@@ -0,0 +1,170 @@
+# Licensed to the StackStorm, Inc ('StackStorm') under one or more
