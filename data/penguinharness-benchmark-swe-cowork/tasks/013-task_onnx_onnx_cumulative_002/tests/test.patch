+    text = printer.to_text(graph)
+    assert "{1,-2,127,-128}" in text.replace(" ", "")
+    parsed = parser.parse_graph(text)
+    np.testing.assert_array_equal(numpy_helper.to_array(parsed.initializer[0]), values)
