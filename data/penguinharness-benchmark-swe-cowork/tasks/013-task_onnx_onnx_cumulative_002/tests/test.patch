+
+
+def test_5528_special_float_literals() -> None:
+    for literal, predicate in (
+        ("inf", math.isinf),
+        ("-infinity", lambda value: math.isinf(value) and value < 0),
+        ("NaN", math.isnan),
+    ):
+        node = parser.parse_node(f"out = Constant <value_float = {literal}> ()")
