+        if (this._overlayCtrl) {
+          this._overlayCtrl.updateConfig(value);
+        }
+        this.__config = value;
+      }
+
+      _requestUpdate(name, oldValue) {
+        super._requestUpdate(name, oldValue);
+        if (name === 'opened') {
+          this.dispatchEvent(new Event('opened-changed'));
+        }
+      }
