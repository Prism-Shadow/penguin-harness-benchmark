+              result += pseudoModifier({basicSelector, pseudoType, pseudoName, lastPseudo});
+              result += ch;
+              basicSelector = '';
+              basicSelectorAdded = false;
+            }
+            pseudoName = '';
+            pseudoMode = MODE_OUT;
+            continue;
+          }
+          default: {
+            pseudoName += ch;
+          }
+        }
+      }
+    }
