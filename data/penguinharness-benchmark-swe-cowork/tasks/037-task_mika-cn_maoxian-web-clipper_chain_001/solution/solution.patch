+class SortedArray {
+  constructor() {
+    this._entries = [];
+  }
+
+  get length() {
+    return this._entries.length;
+  }
+
+  push(value, index) {
+    const missing = index === undefined || index === null || String(index).trim() === '';
+    const numeric = missing ? undefined : Number(index);
+    this._entries.push({value, index: Number.isInteger(numeric) ? numeric : undefined});
+  }
+
+  [Symbol.iterator]() {
+    const ordered = [...this._entries].sort((left, right) => {
+      if (left.index === undefined) return right.index === undefined ? 0 : 1;
+      if (right.index === undefined) return -1;
+      return left.index - right.index;
+    });
+    return ordered.map((entry) => entry.value)[Symbol.iterator]();
+  }
+}
+
+export default SortedArray;
