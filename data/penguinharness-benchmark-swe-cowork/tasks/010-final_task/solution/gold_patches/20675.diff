-      handleExportedDeclaration(statement, flags);
-    }
-  });
-
-  return flags;
-})();
-
-/**
- * @param d {ts.VariableStatement}
- * @param map {{[flag: string]: string}}
- */
-function handleExportedDeclaration(d, map) {
