-const DEPRECATED_FEATURES = (function getFeatures() {
-  let fileName = path.join(
-    __dirname,
-    '..',
-    'packages',
-    '@ember',
-    'deprecated-features',
-    'index.ts'
-  );
-  let contents = fs.readFileSync(fileName, 'utf8');
