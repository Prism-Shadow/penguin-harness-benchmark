diff --git a/config/mongo.rb b/config/mongo.rb
new file mode 100644
index 0000000000000000000000000000000000000000..385da9866fd2464c8cba8155c4db68b0e4b3222c
--- /dev/null
+++ b/config/mongo.rb
@@ -0,0 +1,25 @@
+log_level = Logger.const_get Errbit::Config.log_level.upcase
+
+Mongoid.logger.level = log_level
+modern_driver = Mongoid::VERSION.to_i >= 5
+driver_logger = modern_driver ? Mongo::Logger : Moped.logger
+driver_logger.level = log_level
+
+Mongoid.configure do |config|
+  uri = if Errbit::Config.mongo_url == 'mongodb://localhost'
+          "mongodb://localhost/errbit_#{Rails.env}"
+        else
+          Errbit::Config.mongo_url
+        end
+
+  config.load_configuration({
+    (modern_driver ? :clients : :sessions) => {
+      default: {
+        uri: uri
+      }
+    },
+    options: {
+      use_activesupport_time_zone: true
+    }
+  })
+end
