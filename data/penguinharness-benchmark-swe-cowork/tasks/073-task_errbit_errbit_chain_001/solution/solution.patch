diff --git a/lib/airbrake_api/v3/notice_parser.rb b/lib/airbrake_api/v3/notice_parser.rb
new file mode 100644
index 0000000000000000000000000000000000000000..84e485f80dd0709204b5884def8e443641d7cc4c
--- /dev/null
+++ b/lib/airbrake_api/v3/notice_parser.rb
@@ -0,0 +1,103 @@
+module AirbrakeApi
+  module V3
+    class NoticeParser
+      attr_reader :params, :error
+
+      def initialize(params)
+        @params = params || {}
+      end
+
+      def report
+        validate_params!
+        attributes = {
+          error_class: error['type'],
+          message: error['message'].to_s,
+          backtrace: backtrace,
+          request: request,
+          server_environment: server_environment,
+          api_key: params['key'].present? ? params['key'] : params['project_id'],
+          notifier: params['notifier'].presence || { 'name' => 'unknown' },
+          user_attributes: user_attributes
+        }
+
+        ErrorReport.new(attributes)
+      end
+
+      private
+
+      def validate_params!
+        raise AirbrakeApi::ParamsError unless params.is_a?(Hash)
+        version = params['api_version']
+        raise AirbrakeApi::ParamsError unless version == '3' || (version.is_a?(Integer) && version == 3)
+        errors = params['errors']
+        raise AirbrakeApi::ParamsError unless errors.is_a?(Array) && errors.any? && errors.first.is_a?(Hash)
+        %w[context environment session params notifier].each do |key|
+          raise AirbrakeApi::ParamsError if params.key?(key) && !params[key].is_a?(Hash)
+        end
+        trace = errors.first['backtrace']
+        unless trace.nil? || (trace.is_a?(Array) && trace.all? { |line| line.is_a?(Hash) })
+          raise AirbrakeApi::ParamsError
+        end
+      end
+
+      def error
+        raise AirbrakeApi::ParamsError unless params.has_key?('errors') && params['errors'].any?
+        @error ||= params['errors'].first
+      end
+
+      def backtrace
+        (error['backtrace'] || []).map do |backtrace_line|
+          {
+            method: backtrace_line['function'],
+            file: backtrace_line['file'],
+            number: backtrace_line['line'],
+            column: backtrace_line['column']
+          }
+        end
+      end
+
+      def server_environment
+        {
+          'environment-name' => context['environment'],
+          'hostname' => hostname,
+          'project-root' => context['rootDirectory'],
+          'app-version' => context['version']
+        }
+      end
+
+      def request
+        environment = (params['environment'] || {}).merge(
+          'HTTP_USER_AGENT' => context['userAgent']
+        )
+
+        {
+          'cgi-data' => environment,
+          'session' => params['session'],
+          'params' => params['params'],
+          'url' => url,
+          'component' => context['component'],
+          'action' => context['action']
+        }
+      end
+
+      def user_attributes
+        hash = context.slice('userId', 'userUsername', 'userName', 'userEmail')
+        Hash[hash.map { |key, value| [key.sub(/^user/, ''), value] }]
+      end
+
+      def url
+        context['url']
+      end
+
+      def hostname
+        URI.parse(url.to_s).hostname
+      rescue URI::InvalidURIError
+        ''
+      end
+
+      def context
+        @context = params['context'] || {}
+      end
+    end
+  end
+end
diff --git a/lib/configurator.rb b/lib/configurator.rb
new file mode 100644
index 0000000000000000000000000000000000000000..1b01f056852f548bc2ae96c64005f9cdb103a5e0
--- /dev/null
+++ b/lib/configurator.rb
@@ -0,0 +1,84 @@
+require 'ostruct'
+require 'yaml'
+
+# Configurator maps lists of environment variables to names that you define in
+# order to provide a consistent way to use configuration throughout your
+# application
+class Configurator
+
+  # Run the configurator and return the processed values
+  #
+  # @example Simple mapping
+  #   ENV['BAR'] = 'onevalue'
+  #   ENV['BAZ'] = 'another'
+  #
+  #   config = Configurator.run({
+  #     key_one: ['FOO', 'BAR'],
+  #     key_two: ['BAZ']
+  #   })
+  #
+  #   config.key_one
+  #   #=> 'onevalue'
+  #   config.key_two
+  #   #=> 'another'
+  #
+  # @example Using override blocks
+  #   ENV['BAR'] = 'onevalue'
+  #   ENV['BAZ'] = 'another'
+  #
+  #   config = Configurator.run({
+  #     key_one: ['FOO', 'BAR', ->(values) {
+  #       values[:key_two]
+  #     }],
+  #     key_two: ['BAZ']
+  #   })
+  #
+  #   config.key_one
+  #   #=> 'another'
+  #
+  # @param Hash map of configuration keys with array values where the array is
+  #   a list of environment variables to scan for configuration
+  # @return OpenStruct configuration object
+  def self.run(mapping)
+    reader = self.new(mapping)
+    reader.read
+  end
+
+  # Create the Configurator object
+  #
+  # @param [Hash] mapping mapping of config names to environment value names
+  # @return [Configurator]
+  def initialize(mapping)
+    @mapping = mapping
+    @overrides = {}
+    @storage = {}
+  end
+
+  # Process the environment variable values and store the overrides
+  def scan
+    @mapping.each do |key, values|
+      values = values.dup
+      @overrides[key] = values.pop if values.last.is_a? Proc
+      env_name = values.find { |v| ENV[v] }
+      @storage[key] = YAML.load(ENV[env_name]) if env_name
+    end
+  end
+
+  # Apply the override functions
+  def apply_overrides
+    @overrides.each do |key, override|
+      @storage[key] = override.call(@storage)
+    end
+  end
+
+  # Perform all the required processing and return the configuration object
+  #
+  # @return [OpenStruct] configuration object
+  def read
+    @storage = {}
+    scan
+    apply_overrides
+
+    OpenStruct.new(@storage)
+  end
+end
