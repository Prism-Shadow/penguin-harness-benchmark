--- /dev/null
+++ b/app/models/fingerprint/md5.rb
@@ -0,0 +1,16 @@
+require 'digest/md5'
+
+module Fingerprint
+  # Compatibility strategy: group by the sanitized first method signature.
+  class MD5 < Sha1
+    def to_s
+      Digest::MD5.hexdigest(fingerprint_source)
+    end
+
+    def fingerprint_source
+      location = notice.backtrace.lines.first || {}
+      method = location['method'] || location[:method]
+      method.to_s.gsub(/[0-9]+|FRAGMENT/, '#').gsub(/_+#/, '_#')
+    end
+  end
+end
