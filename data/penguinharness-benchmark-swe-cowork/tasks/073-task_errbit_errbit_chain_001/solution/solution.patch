diff --git a/app/controllers/api/v3/notices_controller.rb b/app/controllers/api/v3/notices_controller.rb
new file mode 100644
index 0000000000000000000000000000000000000000..1f20cf5786bb938dad79b1c34c03bca1a1d4c795
--- /dev/null
+++ b/app/controllers/api/v3/notices_controller.rb
@@ -0,0 +1,30 @@
+class Api::V3::NoticesController < ApplicationController
+  skip_before_action :verify_authenticity_token
+  skip_before_action :authenticate_user!
+
+  respond_to :json
+
+  def create
+    body = JSON.parse(request.raw_post)
+    raise AirbrakeApi::ParamsError unless body.is_a?(Hash)
+    report = AirbrakeApi::V3::NoticeParser.new(body.merge('project_id' => params[:project_id])).report
+
+    if report.valid?
+      if report.should_keep?
+        report.generate_notice!
+        render json: {
+          id: report.notice.id,
+          url: app_problem_url(
+            report.app,
+            report.error.problem_id)
+        }
+      else
+        render text: 'Notice for old app version ignored'
+      end
+    else
+      render text: 'Your API key is unknown', status: 422
+    end
+  rescue AirbrakeApi::ParamsError, JSON::ParserError
+    render text: 'Invalid request', status: 400
+  end
+end
