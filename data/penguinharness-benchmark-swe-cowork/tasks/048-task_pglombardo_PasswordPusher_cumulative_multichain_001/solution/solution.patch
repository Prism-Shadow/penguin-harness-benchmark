@@ -0,0 +1,25 @@
+module Pwpush::AssignNotifiableByEmailFields
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :serialize_notification_quota
+  end
+
+  def assign_notify_by_email_fields(record, required:)
+    record.notify_by_email_creator = current_user if user_signed_in?
+    record.notify_emails_to_required = required
+  end
+
+  private
+
+  def serialize_notification_quota
+    # The request must validate and reserve both the per-push and per-user
+    # allowances together. All pushes for an owner share this database lock;
+    # reloading the owner also prevents a stale daily-usage observation.
+    if %w[create notify_emails].include?(action_name) && user_signed_in?
+      current_user.with_lock { yield }
+    else
+      yield
+    end
+  end
+end
