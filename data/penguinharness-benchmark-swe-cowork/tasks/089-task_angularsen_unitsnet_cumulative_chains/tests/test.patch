+
+def check_1716_numeric_format_annotations() -> None:
+    run_modular_probe(
+        r'''
+using System;
+using System.Diagnostics.CodeAnalysis;
+using System.Linq;
+using System.Reflection;
+using UnitsNet;
+using UnitsNet.Modular;
+using Catalog = UnitsNet.Modular.BuiltIns;
