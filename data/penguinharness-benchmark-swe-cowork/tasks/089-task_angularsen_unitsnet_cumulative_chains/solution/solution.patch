diff --git a/UnitsNet.Modular/Directory.Build.props b/UnitsNet.Modular/Directory.Build.props
new file mode 100644
index 0000000000000000000000000000000000000000..7c216aae852a4b11b5f99efea708a393443e6755
--- /dev/null
+++ b/UnitsNet.Modular/Directory.Build.props
@@ -0,0 +1,27 @@
+<Project>
+  <!-- Preserve repository-wide build settings when this nearer props file is discovered. -->
+  <Import Project="../Directory.Build.props" />
+
+  <!-- Register analyzer-config metadata before IDE design-time builds capture the project model. -->
+  <Import Project="UnitsNet.Modular.Generator/buildTransitive/UnitsNet.Modular.Generator.props" />
+
+  <!--
+    MinVer versions both the public runtime and its bundled generator. The prefix isolates their
+    versions from the existing UnitsNet/* and JsonNet/* tags in this monorepo.
+  -->
+  <PropertyGroup>
+    <MinVerTagPrefix>UnitsNet.Modular/</MinVerTagPrefix>
+    <MinVerMinimumMajorMinor>6.0</MinVerMinimumMajorMinor>
+    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
+  </PropertyGroup>
+
+  <!-- Reproducible portable symbols with Source Link are part of the package quality contract. -->
+  <PropertyGroup>
+    <DebugType>portable</DebugType>
+    <Deterministic>true</Deterministic>
+    <EmbedUntrackedSources>true</EmbedUntrackedSources>
+    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
+    <!-- Only the combined runtime + generator project is a public package. -->
+    <IsPackable>false</IsPackable>
+  </PropertyGroup>
+</Project>
