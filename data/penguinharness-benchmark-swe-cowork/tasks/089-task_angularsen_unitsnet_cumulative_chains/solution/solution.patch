+<Project Sdk="Microsoft.NET.Sdk"
+         TreatAsLocalProperty="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier">
+  <PropertyGroup>
+    <TargetFramework>netstandard2.0</TargetFramework>
+    <LangVersion>latest</LangVersion>
+    <Nullable>enable</Nullable>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <RootNamespace>UnitsNet.Modular.Generator</RootNamespace>
+    <IsRoslynComponent>true</IsRoslynComponent>
+    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
+    <NoWarn>$(NoWarn);RS1036;RS2008</NoWarn>
+    <!-- Analyzer assemblies are build-time inputs and are never part of an application's native publish. -->
+    <PublishAot>false</PublishAot>
+    <PublishTrimmed>false</PublishTrimmed>
+    <SelfContained>false</SelfContained>
+    <RuntimeIdentifier />
+  </PropertyGroup>
+  <ItemGroup>
+    <PackageReference Include="MinVer" PrivateAssets="all" />
+    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
+    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
+  </ItemGroup>
+  <ItemGroup>
+    <EmbeddedResource Include="../../Common/UnitDefinitions/*.json"
+                      LogicalName="UnitsNet.Modular.Generator.BuiltIns.Quantities.%(Filename).json" />
+    <EmbeddedResource Include="../../Common/UnitRelations.json"
+                      LogicalName="UnitsNet.Modular.Generator.BuiltIns.UnitRelations.json" />
+    <EmbeddedResource Include="../../Common/UnitEnumValues.g.json"
+                      LogicalName="UnitsNet.Modular.Generator.BuiltIns.UnitEnumValues.json" />
+    <EmbeddedResource Include="BuiltInAugmentations.json"
+                      LogicalName="UnitsNet.Modular.Generator.BuiltIns.Augmentations.json" />
+    <EmbeddedResource Include="BuiltInCompanions.json"
+                      LogicalName="UnitsNet.Modular.Generator.BuiltIns.Companions.json" />
+  </ItemGroup>
+</Project>
