+    @aiohttp_apispec.docs(tags=['relationships'])
+    @aiohttp_apispec.response_schema(RelationshipSchema)
+    async def delete_relationships(self, request: web.Request):
+        knowledge_svc_handle = self._api_manager.knowledge_svc
