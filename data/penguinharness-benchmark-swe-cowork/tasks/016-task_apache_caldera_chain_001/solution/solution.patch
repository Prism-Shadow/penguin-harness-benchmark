@@ -0,0 +1,29 @@
+import abc
+
+
+class ObjectServiceInterface(abc.ABC):
+
+    @staticmethod
+    @abc.abstractmethod
+    def destroy():
+        """
+        Clear out all data
+        :return:
+        """
+        pass
+
+    @abc.abstractmethod
+    def save_state(self):
+        """
+        Save stored data to disk
+        :return:
+        """
+        pass
+
+    @abc.abstractmethod
+    def restore_state(self):
+        """
+        Load data from disk
+        :return:
+        """
+        pass
