+
+
+def test_link_fact_save_sets_source_and_deduplicates_link_ids():
+    from app.objects.secondclass.c_fact import Fact
+    from app.objects.secondclass.c_link import Link
+    from app.utility.base_service import BaseService
+
+    existing = Fact(
+        trait="host.name",
+        value="alpha",
+        source="link-2205",
+        links=["link-2205"],
+    )
+
+    class Knowledge:
+        async def check_fact_exists(self, fact, listing):
+            return True
+
+        async def get_facts(self, criteria):
+            assert criteria["source"] == "link-2205"
+            return [existing]
+
+        async def update_fact(self, criteria, updates):
+            existing.links = updates["links"]
+
+    old_get_service = BaseService.get_service
+    BaseService.get_service = classmethod(
+        lambda cls, name: Knowledge() if name == "knowledge_svc" else None
+    )
+    try:
+        link = object.__new__(Link)
+        link.id = "link-2205"
+        link.paw = "paw-2205"
+        link.facts = []
+        link.ability = type("Ability", (), {"technique_id": "T-test"})()
+        fact = Fact(trait="host.name", value="alpha", source="untrusted-source")
+        parameters = inspect.signature(link._save_fact).parameters
+        args = (None, fact, 1, None) if "relationship" in parameters else (None, fact, 1)
+        asyncio.run(link._save_fact(*args))
+        assert fact.source == "link-2205"
+        assert existing.links == ["link-2205"]
+    finally:
+        BaseService.get_service = old_get_service
+
