+import asyncio
+
+
+def test_file_download_encoding_uses_registered_encoder():
+    from app.service.file_svc import FileSvc
+
+    class Encoder:
+        def encode(self, value):
+            return b"encoded:" + value
+
+    class Data:
+        async def locate(self, collection, match=None):
+            assert collection == "data_encoders"
+            return [Encoder()]
+
+    service = object.__new__(FileSvc)
+    service.data_svc = Data()
+    class Log:
+        def debug(self, *args):
+            pass
+        def error(self, *args):
+            pass
+    service.log = Log()
+    encoded = asyncio.run(service._perform_data_encoding({"x-file-encoding": "demo"}, b"payload"))
+    assert encoded == b"encoded:payload"
