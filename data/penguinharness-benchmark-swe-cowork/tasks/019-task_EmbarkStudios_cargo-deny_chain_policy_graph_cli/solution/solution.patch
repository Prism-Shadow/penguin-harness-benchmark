+    // Mdiamond,
+    // Msquare,
+    // Mcircle,
+    // rect,
+    // rectangle,
+    // square,
+    // star,
+    // none,
+    // underline,
+    // cylinder,
+    // note,
+    // tab,
+    // folder,
+    // box3d,
+    // component,
+    // promoter,
+    // cds,
+    // terminator,
+    // utr,
+    // primersite,
+    // restrictionsite,
+    // fivepoverhang,
+    // threepoverhang,
+    // noverhang,
+    // assembly,
+    // signature,
+    // insulator,
+    // ribosite,
+    // rnastab,
+    // proteasesite,
+    // proteinstab,
