-                }
-            }
-        }
-    }
-
-    if warnings > 0 {
-        warn!(log, "encountered {} license warnings", warnings);
-    }
-
-    if errors > 0 {
-        error!(log, "encountered {} license errors", errors);
-        failure::bail!("failed license check");
-    }
-
-    Ok(())
-}
