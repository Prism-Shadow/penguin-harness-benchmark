+}
+
+type Id = pg::graph::NodeIndex<u32>;
+
+#[allow(non_camel_case_types)]
+#[derive(Debug)]
+pub enum Shape {
+    r#box,
+    // polygon,
+    // ellipse,
+    // oval,
