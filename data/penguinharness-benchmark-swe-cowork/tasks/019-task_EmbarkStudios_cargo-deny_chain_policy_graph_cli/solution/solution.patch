-
-                                                match spdx::license_id(&identified.name) {
-                                                    Some(id) => Note::License {
-                                                        name: id,
-                                                        source: (identified.kind, fs).into(),
-                                                    },
-                                                    None => Note::Unknown {
-                                                        name: identified.name.to_owned(),
-                                                        source: (identified.kind, fs).into(),
