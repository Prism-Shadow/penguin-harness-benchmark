-    if (is_string($token)) {
-      if ($json = json_decode($token, true)) {
-        $token = $json;
-      } else {
-        // assume $token is just the token string
-        $token = array(
-          'access_token' => $token,
-        );
-      }
-    }
-    if ($token == null) {
-      throw new InvalidArgumentException('invalid json token');
