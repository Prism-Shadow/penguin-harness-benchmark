-      if ($response instanceof \GuzzleHttp\Message\ResponseInterface) {
-        $response = new Response(
-            $response->getStatusCode(),
-            $response->getHeaders() ?: [],
-            $response->getBody(),
-            $response->getProtocolVersion(),
-            $response->getReasonPhrase()
