FROM harbor.tokenwave.us/release/cowork-bench/024-workplace@sha256:646eb33081ed74eb492ec5d6cab3da3c574608da7b34564fc5508a1f3e0fc059
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY workplace-service/*.py /usr/local/bin/
COPY workplace-service/workplace-sidecar /usr/local/bin/workplace-sidecar
COPY workplace-service/original /opt/tokenwave-original
COPY workplace_mcp.py /usr/local/bin/workplace-mcp
RUN chmod 755 /usr/local/bin/workplace-sidecar /usr/local/bin/workplace-mcp && chmod -R a+rX /opt/tokenwave-original
