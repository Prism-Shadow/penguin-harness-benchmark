+        break;
+
+    case 1920:
+        probe_expect(class_exists('Stripe\\V2\\Core\\Event'), 'V2 event resource uses the Core namespace');
+        probe_expect(!class_exists('Stripe\\V2\\Event'), 'pre-migration V2 event namespace is no longer exported');
