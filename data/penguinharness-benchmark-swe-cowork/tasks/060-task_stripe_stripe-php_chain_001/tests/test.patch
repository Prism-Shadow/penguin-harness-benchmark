+require $repo . '/init.php';
+
+$payload = static function (): string {
+    return json_encode([
+        'id' => 'evt_probe',
+        'object' => 'v2.core.event',
+        'type' => 'v1.billing.meter.no_meter_found',
+        'livemode' => false,
+        'created' => '2026-01-01T00:00:00Z',
+        'context' => null,
+    ], JSON_THROW_ON_ERROR);
+};
