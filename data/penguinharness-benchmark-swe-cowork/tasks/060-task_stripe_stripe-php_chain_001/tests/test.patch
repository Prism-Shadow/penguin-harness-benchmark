+        probe_expect($options[CURLOPT_POSTFIELDS] === '', 'empty POST body is the empty string');
+        break;
+
+    case 1889:
+        $deleted = Stripe\Util\Util::convertToStripeObject(
+            ['id' => 'deleted_probe', 'object' => 'future.object'],
+            [],
+            'v2',
+            true
+        );
