-<?php
-
-namespace Elastica;
-
-use Elastica\Exception\InvalidException;
-use Elastica\Exception\NotFoundException;
-use Elastica\Exception\RuntimeException;
-use Elastica\ResultSet\BuilderInterface;
-use Elastica\Script\AbstractScript;
