+
+    return {
+        "is_sufficient": is_suff,
+        "confidence": auto_confidence,
+        "missing": missing,
+        "contradictions": contradictions,
+        "required_entities": required_entities,
+        "coverage": coverage,
+        "reasoning": reasoning,
+        "followups": followups,
+    }
