+func refreshWikiProductVectors(ctx context.Context, tenant string, products []kccommon.Product) ([]kccommon.Product, error) {
+	var indexes []int
+	var texts []string
+	for i, p := range products {
+		if p.Variant == kccommon.VariantWiki && (p.Meta["embedding_dirty"] == true || len(p.Vector) == 0) {
+			indexes = append(indexes, i)
+			texts = append(texts, p.Content)
+		}
+	}
+	if len(indexes) == 0 {
+		return products, nil
+	}
+	deps, err := kccommon.ResolveDeps(tenant, defaultLLMID, defaultEmbedding)
+	if err != nil {
+		return nil, err
+	}
+	if deps.Embed == nil {
+		return nil, fmt.Errorf("Wiki page embedding model is unavailable")
+	}
+	vectors, err := deps.Embed.Encode(ctx, texts)
+	if err != nil {
+		return nil, err
+	}
+	if len(vectors) != len(indexes) {
+		return nil, fmt.Errorf("Wiki page embedding count mismatch")
+	}
+	for n, i := range indexes {
+		if len(vectors[n]) == 0 {
+			return nil, fmt.Errorf("Wiki page embedding is empty")
+		}
+		products[i].Vector = vectors[n]
+		delete(products[i].Meta, "embedding_dirty")
+	}
+	return products, nil
+}
+
+func productContentsForEmbedding(products []kccommon.Product) []string {
+	contents := make([]string, len(products))
+	for i := range products {
+		contents[i] = products[i].Content
+	}
+	return contents
+}
