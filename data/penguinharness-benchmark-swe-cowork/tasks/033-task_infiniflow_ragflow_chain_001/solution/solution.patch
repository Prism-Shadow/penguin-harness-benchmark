index 0000000000000000000000000000000000000000..31248b01e98716664ac5ff933f7d7f1599d0b316
--- /dev/null
+++ b/internal/service/agent_memory_adapter.go
@@ -0,0 +1,59 @@
+package service
+
+import (
+	"context"
+	"fmt"
+
+	"gorm.io/gorm"
+	"ragflow/internal/agent/runtime"
+	"ragflow/internal/common"
+)
+
+type agentMemorySearch interface {
+	SearchMessage(context.Context, string, map[string]interface{}, map[string]interface{}) ([]map[string]interface{}, common.ErrorCode, error)
+}
+
+// AgentMemoryAdapter connects the registered agent runtime to the existing
+// memory service, which enforces memory access before querying the index.
+type AgentMemoryAdapter struct{ service agentMemorySearch }
+
+func NewAgentMemoryAdapter(service agentMemorySearch) *AgentMemoryAdapter {
+	return &AgentMemoryAdapter{service: service}
+}
+
+func (a *AgentMemoryAdapter) Search(ctx context.Context, _ *gorm.DB, req runtime.RetrievalRequest) ([]runtime.RetrievalChunk, error) {
+	if a == nil || a.service == nil {
+		return nil, runtime.ErrMemoryRetrievalServiceMissing
+	}
+	if len(req.MemoryIDs) == 0 {
+		return []runtime.RetrievalChunk{}, nil
+	}
+	filter := map[string]interface{}{"memory_id": append([]string(nil), req.MemoryIDs...)}
+	params := map[string]interface{}{"query": req.Query, "top_n": req.TopN}
+	if req.KeywordsSimilarityWeight != nil {
+		params["keywords_similarity_weight"] = *req.KeywordsSimilarityWeight
+	}
+	if req.SimilarityThresholdSet || req.SimilarityThreshold > 0 {
+		params["similarity_threshold"] = req.SimilarityThreshold
+	}
+	messages, code, err := a.service.SearchMessage(ctx, req.TenantID, filter, params)
+	if err != nil {
+		return nil, err
+	}
+	if code != common.CodeSuccess {
+		return nil, fmt.Errorf("memory retrieval failed: code %v", code)
+	}
+	chunks := make([]runtime.RetrievalChunk, 0, len(messages))
+	for _, message := range messages {
+		id := ""
+		if value := message["message_id"]; value != nil {
+			id = fmt.Sprint(value)
+		}
+		score, _ := runtime.NumberFromMap(message, "similarity")
+		chunks = append(chunks, runtime.RetrievalChunk{
+			ID: id, Content: runtime.StringFromMap(message, "content"),
+			DatasetID: runtime.StringFromMap(message, "memory_id"), Score: score,
+		})
+	}
+	return chunks, nil
+}
