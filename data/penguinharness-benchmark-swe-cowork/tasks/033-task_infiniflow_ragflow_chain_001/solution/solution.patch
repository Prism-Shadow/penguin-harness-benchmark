+package infinity
+
+import (
+	"encoding/json"
+	"fmt"
+	"path"
+	"sort"
+	"strings"
+)
+
+// Compiled products carry typed metadata in addition to the physical schema.
+// Keep extensions in the existing extra column; adding a compiler must not
+// require changing every already-created dataset table.
+func packCompiledFields(row map[string]interface{}, columns map[string]bool) (map[string]interface{}, error) {
+	if row["compile_kwd"] == nil || row["compile_kwd"] == "" {
+		return row, nil
+	}
+	out := map[string]interface{}{}
+	extra := map[string]interface{}{}
+	if raw, ok := row["extra"].(string); ok && raw != "" {
+		if err := json.Unmarshal([]byte(raw), &extra); err != nil {
+			return nil, fmt.Errorf("compiled metadata extra: %w", err)
+		}
+	}
+	if extra == nil {
+		extra = map[string]interface{}{}
+	}
+	for key, value := range row {
+		if columns[key] {
+			out[key] = value
+			continue
+		}
+		if strings.HasPrefix(key, "q_") && strings.HasSuffix(key, "_vec") {
+			return nil, fmt.Errorf("compiled vector column %q is absent from dataset schema", key)
+		}
+		extra[key] = value
+	}
+	if len(extra) > 0 {
+		if !columns["extra"] {
+			return nil, fmt.Errorf("compiled metadata requires extra column")
+		}
+		encoded, err := json.Marshal(extra)
+		if err != nil {
+			return nil, err
+		}
+		out["extra"] = string(encoded)
+	}
+	return out, nil
+}
+
+// Infinity Output uses physical column names rather than Elasticsearch-style
+// wildcards. Expand vector patterns and read metadata extensions via extra.
+func compiledSelectColumns(requested []string, columns map[string]bool) []string {
+	out := []string{}
+	seen := map[string]bool{}
+	add := func(key string) {
+		if !seen[key] {
+			seen[key] = true
+			out = append(out, key)
+		}
+	}
+	keys := make([]string, 0, len(columns))
+	for key := range columns {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, field := range requested {
+		if columns[field] || strings.HasSuffix(field, "()") {
+			add(field)
+			continue
+		}
+		if strings.ContainsAny(field, "*?") {
+			for _, key := range keys {
+				if ok, _ := path.Match(field, key); ok {
+					add(key)
+				}
+			}
+		}
+		if columns["extra"] {
+			add("extra")
+		}
+	}
+	return out
+}
+func restoreCompiledFields(rows []map[string]interface{}) error {
+	for _, row := range rows {
+		raw, ok := row["extra"].(string)
+		if !ok || raw == "" {
+			continue
+		}
+		var extra map[string]interface{}
+		if err := json.Unmarshal([]byte(raw), &extra); err != nil {
+			continue
+		} // legacy extra may be plain text
+		for key, value := range extra {
+			if _, exists := row[key]; !exists {
+				row[key] = value
+			}
+		}
+	}
+	return nil
+}
+
+var compiledJSONLists = map[string]bool{
+	"entity_names": true, "claims": true, "page_ids": true, "aliases": true,
+	"source_chunk_ids": true, "source_doc_ids": true, "compilation_template_ids": true, "doc_ids_kwd": true,
+	"entity_names_kwd": true, "outlinks_kwd": true, "related_kb_pages_kwd": true, "rechunked_from_chunk_ids": true,
+}
+
+func compiledList(value interface{}) []interface{} {
+	switch values := value.(type) {
+	case []interface{}:
+		return values
+	case []string:
+		out := make([]interface{}, len(values))
+		for i, v := range values {
+			out[i] = v
+		}
+		return out
+	case string:
+		var out []interface{}
+		if json.Unmarshal([]byte(values), &out) == nil && out != nil {
+			return out
+		}
+		for _, v := range strings.Split(values, "###") {
+			if v != "" {
+				out = append(out, v)
+			}
+		}
+		return out
+	}
+	return []interface{}{}
+}
+func compiledFieldCondition(key string, value interface{}) (string, bool) {
+	jsonList := compiledJSONLists[key]
+	if !jsonList && key != "compile_kwd" && key != "parent_kwd" && key != "type_kwd" && key != "scope_kwd" {
+		return "", false
+	}
+	var values []interface{}
+	switch v := value.(type) {
+	case []interface{}:
+		values = v
+	case []string:
+		for _, x := range v {
+			values = append(values, x)
+		}
+	default:
+		values = []interface{}{v}
+	}
+	var clauses []string
+	for _, item := range values {
+		if jsonList {
+			encoded, _ := json.Marshal(item)
