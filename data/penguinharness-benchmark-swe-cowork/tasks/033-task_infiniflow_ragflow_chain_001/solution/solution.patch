new file mode 100644
index 0000000000000000000000000000000000000000..743bf80888877d59df4741e4eb8ede0c2130915d
--- /dev/null
+++ b/internal/ingestion/component/knowledge_compiler/wiki/plan_budget.go
@@ -0,0 +1,73 @@
+package wiki
+
+import "sort"
+
+type wikiPlanBudget struct{ Target, Max, MaxTokens int }
+
+func (b wikiPlanBudget) Cap() int { return b.Max }
+func wikiExtractItemCount(e wikiExtract) int {
+	return len(e.Entities) + len(e.Concepts) + len(e.Topics)
+}
+func deriveWikiPlanBudget(contextLength, items int) wikiPlanBudget {
+	if contextLength <= 0 {
+		contextLength = 8192
+	}
+	tokens := min(4096, max(1024, contextLength*4/10))
+	target := max(1, (items+3)/4)
+	return wikiPlanBudget{Target: target, Max: min(max(1, (tokens-256)/48), max(target+8, target*2)), MaxTokens: tokens}
+}
+
+// Allocate the finite page budget across nonempty communities without rounding
+// the total above the model's output capacity.
+func allocatePlanQuotas(groups []wikiExtract, capacity int) []int {
+	result := make([]int, len(groups))
+	for capacity > 0 {
+		changed := false
+		for i, g := range groups {
+			if capacity == 0 {
+				break
+			}
+			if result[i] >= max(1, wikiExtractItemCount(g)) {
+				continue
+			}
+			result[i]++
+			capacity--
+			changed = true
+		}
+		if !changed {
+			break
+		}
+	}
+	return result
+}
+func truncatePlanPagesByCap(pages []wikiPlanPage, capacity int, _ wikiExtract) ([]wikiPlanPage, int) {
+	if capacity < 0 {
+		capacity = 0
+	}
+	if len(pages) <= capacity {
+		return pages, 0
+	}
+	// Preserve deterministic planner order within each group, spreading the
+	// cap over communities rather than dropping every later community.
+	groups := map[string][]wikiPlanPage{}
+	order := []string{}
+	for _, p := range pages {
+		if _, ok := groups[p.PlanGroup]; !ok {
+			order = append(order, p.PlanGroup)
+		}
+		groups[p.PlanGroup] = append(groups[p.PlanGroup], p)
+	}
+	sort.Strings(order)
+	out := make([]wikiPlanPage, 0, capacity)
+	for round := 0; len(out) < capacity; round++ {
+		for _, g := range order {
+			if round < len(groups[g]) {
+				out = append(out, groups[g][round])
+				if len(out) == capacity {
+					break
+				}
+			}
+		}
+	}
+	return out, len(pages) - len(out)
+}
