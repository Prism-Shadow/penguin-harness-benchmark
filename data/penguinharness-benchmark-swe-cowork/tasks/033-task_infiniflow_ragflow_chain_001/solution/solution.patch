+import (
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"ragflow/internal/common"
+)
+
+// GetCompilationStatus returns the authenticated dataset scheduler state.
+func (h *DatasetsHandler) GetCompilationStatus(c *gin.Context) {
+	user, code, message := GetUser(c)
+	if code != common.CodeSuccess {
+		common.ErrorWithCode(c, code, message)
+		return
+	}
+	status, code, err := h.datasetsService.GetDatasetCompilationStatus(
+		c.Request.Context(), user.ID, strings.TrimSpace(c.Param("dataset_id")))
+	if err != nil {
+		common.ErrorWithCode(c, code, err.Error())
+		return
+	}
+	common.SuccessWithData(c, status, "success")
+}
