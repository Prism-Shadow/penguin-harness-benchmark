+// WithRetrievalScope carries the server's trusted binding independently of
+// canvas state. Copies prevent a caller or parallel branch mutating the binding.
+func WithRetrievalScope(ctx context.Context, tenant string, datasets []string) context.Context {
+	return context.WithValue(ctx, retrievalScopeKey{}, retrievalScope{tenant: tenant, datasets: append([]string(nil), datasets...)})
