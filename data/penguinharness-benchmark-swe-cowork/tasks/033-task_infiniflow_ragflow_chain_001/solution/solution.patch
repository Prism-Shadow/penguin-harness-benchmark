+		}
+		if b.TemplateID != "" {
+			row["compilation_template_ids"] = []string{b.TemplateID}
+		}
+		if len(b.TemplateIDs) > 0 {
+			row["compilation_template_ids"] = b.TemplateIDs
+		}
