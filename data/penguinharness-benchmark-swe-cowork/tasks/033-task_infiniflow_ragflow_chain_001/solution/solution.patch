+    if matrix.ndim != 2 or matrix.shape[0] <= 1:
+        return 1.0
+    centroid = np.mean(matrix, axis=0)
+    norm = np.linalg.norm(centroid)
+    if norm <= 0:
+        return 0.0
+    return float(np.mean(matrix @ (centroid / norm)))
