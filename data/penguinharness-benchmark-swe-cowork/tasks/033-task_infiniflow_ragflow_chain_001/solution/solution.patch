+
+    seen: set[int] = set()
+    groups: list[list[dict]] = []
+    for raw_group in raw_groups:
+        if not isinstance(raw_group, list) or not raw_group or len(raw_group) > PAGE_CLUSTER_HARD_MAX_SIZE:
+            return None
