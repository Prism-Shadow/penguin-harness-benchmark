+
+    # root entity = entity whose name never appears as a relation target
+    root_name = ""
+    root_summary = ""
+    for ent in entities:
+        if isinstance(ent, dict) and ent.get("name") not in child_names:
+            root_name = (ent.get("name") or "").strip()
