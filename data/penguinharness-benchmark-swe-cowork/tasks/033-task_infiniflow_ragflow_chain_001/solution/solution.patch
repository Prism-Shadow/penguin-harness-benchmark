index 0000000000000000000000000000000000000000..ee3664866c1aac78fdca20ec2d33f7f1253f71e9
--- /dev/null
+++ b/web/src/pages/next-chats/chat-stream/run-stream.ts
@@ -0,0 +1,143 @@
+/**
+ * Module-level SSE driver. Deliberately not a hook: it must keep running (and
+ * keep writing into the store) after the chat page unmounts, so that navigating
+ * away mid-answer and back shows the stream still in progress.
+ */
+import { IMessage, Variable } from '@/interfaces/database/chat';
+import {
+  CompletionChunk,
+  parseCompletionEventStream,
+  readJsonSafely,
+  requestChatCompletionStream,
+} from '@/services/chat-completion-stream';
+import { AnswerFlushIntervalMs } from './constants';
+import { useChatStreamStore } from './store';
+import { mergeAnswerChunk } from './utils';
+
+export type RunChatCompletionStreamParams = {
+  conversationId: string;
+  chatId?: string;
+  messages: IMessage[];
+  enableThinking?: string;
+  enableInternet?: boolean;
+  agentMode?: string;
+  llmSetting?: Variable;
+  signal?: AbortSignal;
+};
+
+export type RunChatCompletionStreamResult = {
+  ok: boolean;
+  aborted: boolean;
+};
+
+export async function runChatCompletionStream({
+  conversationId,
+  chatId,
+  messages,
+  enableThinking,
+  enableInternet,
+  agentMode,
+  llmSetting,
+  signal,
+}: RunChatCompletionStreamParams): Promise<RunChatCompletionStreamResult> {
+  const { beginStream, applyAnswer, endStream } = useChatStreamStore.getState();
+
+  const controller = new AbortController();
+  if (!beginStream(conversationId, controller, messages)) {
+    return { ok: false, aborted: false };
+  }
+
+  const abort = () => controller.abort();
+  signal?.addEventListener('abort', abort, { once: true });
+  if (signal?.aborted) controller.abort();
+
+  // Kept local rather than read back from the store: it must stay immune to
+  // concurrent mutations of the message list, and mergeAnswerChunk's
+  // `startsWith` / think-marker behaviour depends on the raw accumulated text
+  // rather than on the rendered message content.
+  let accumulatedAnswer = '';
+  let aborted = false;
+  let ok = true;
+
+  // Chunks arrive faster than the UI can use them, so they're coalesced into a
+  // single store write per AnswerFlushIntervalMs. Fields are merged rather than
+  // replaced so a `reference` or `prompt` that arrived on a skipped chunk isn't
+  // lost; the buffer resets on each flush, matching the legacy "newest chunk
+  // wins" semantics across flush windows.
+  let pendingChunk: CompletionChunk | undefined;
+  let lastFlushAt = 0;
+
+  const flushAnswer = () => {
+    if (!pendingChunk) return;
+    applyAnswer(conversationId, {
+      ...pendingChunk,
+      answer: accumulatedAnswer,
+      conversationId,
+    });
+    pendingChunk = undefined;
+    lastFlushAt = Date.now();
+  };
+
+  try {
+    const response = await requestChatCompletionStream(
+      {
+        chatId,
+        sessionId: conversationId,
+        messages,
+        enableThinking,
+        enableInternet,
+        agentMode,
+        llmSetting,
+      },
+      controller.signal,
+    );
+
+    if (!response.ok) {
+      return { ok: false, aborted: false };
+    }
+
+    // JSON error envelopes are not event streams. Do not clone a live SSE
+    // response: teeing it buffers the entire answer for an unused JSON parser.
+    if (response.headers.get('content-type')?.includes('application/json')) {
+      await readJsonSafely(response);
+      return { ok: false, aborted: false };
+    }
+    let received = false;
+
+    try {
+      for await (const chunk of parseCompletionEventStream(response)) {
+        received = true;
+        accumulatedAnswer = mergeAnswerChunk(accumulatedAnswer, chunk);
+        pendingChunk = pendingChunk ? { ...pendingChunk, ...chunk } : chunk;
+
+        // The first chunk flushes immediately (lastFlushAt is 0), so the empty
+        // placeholder is replaced without waiting out an interval.
+        if (chunk.final || Date.now() - lastFlushAt >= AnswerFlushIntervalMs) {
+          flushAnswer();
+        }
+      }
+    } catch (error) {
+      if (error instanceof DOMException && error.name === 'AbortError') {
+        aborted = true;
+      } else {
+        throw error;
+      }
+    }
+
+    if (!received && !aborted) ok = false;
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'AbortError') {
+      aborted = true;
+    } else {
+      ok = false;
+    }
+  } finally {
+    // Whatever was buffered must land, including on abort: a stopped answer
+    // keeps the text produced up to that point.
+    flushAnswer();
+    endStream(conversationId);
+    signal?.removeEventListener('abort', abort);
+  }
+
+  return { ok, aborted };
+}
diff --git a/web/src/pages/next-chats/chat-stream/store.ts b/web/src/pages/next-chats/chat-stream/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a902de1698d7c328be4fab66e2899a3f1b358039
--- /dev/null
+++ b/web/src/pages/next-chats/chat-stream/store.ts
@@ -0,0 +1,63 @@
+import { MessageType } from '@/constants/chat';
+import type { IMessage } from '@/interfaces/database/chat';
+import type { CompletionChunk } from '@/services/chat-completion-stream';
+import { create } from 'zustand';
+
+type Session = {
+  messages: IMessage[];
+  controller?: AbortController;
+  failedText?: string;
+};
+type MessagesUpdate = IMessage[] | ((messages: IMessage[]) => IMessage[]);
+type StreamState = {
+  sessions: Record<string, Session>;
+  setMessages(id: string, update: MessagesUpdate): void;
+  beginStream(id: string, controller: AbortController, messages: IMessage[]): boolean;
+  applyAnswer(id: string, chunk: CompletionChunk): void;
+  endStream(id: string): void;
+  failStream(id: string, text: string): void;
+  takeFailedText(id: string): string | undefined;
+};
+
+export const useChatStreamStore = create<StreamState>((set, get) => ({
+  sessions: {},
+  setMessages(id, update) {
+    const session = get().sessions[id] ?? { messages: [] };
+    // A stale server query must not replace a live stream after navigation.
+    if (session.controller) return;
+    const messages = typeof update === 'function' ? update(session.messages) : update;
+    set((state) => ({ sessions: { ...state.sessions, [id]: { ...session, messages } } }));
+  },
+  beginStream(id, controller, messages) {
+    if (get().sessions[id]?.controller) return false;
+    const question = messages.at(-1);
+    const placeholder = { role: MessageType.Assistant, content: '', id: question?.id, conversationId: id } as IMessage;
+    set((state) => ({ sessions: { ...state.sessions, [id]: { messages: [...messages, placeholder], controller } } }));
+    return true;
+  },
+  applyAnswer(id, chunk) {
+    const session = get().sessions[id];
+    if (!session) return;
+    const previous = session.messages.at(-1);
+    const answer = { ...previous, ...chunk, role: MessageType.Assistant, content: chunk.answer ?? previous?.content ?? '', conversationId: id } as IMessage;
+    set((state) => ({ sessions: { ...state.sessions, [id]: { ...session, messages: [...session.messages.slice(0, -1), answer] } } }));
+  },
+  endStream(id) {
+    const session = get().sessions[id];
+    if (session) set((state) => ({ sessions: { ...state.sessions, [id]: { ...session, controller: undefined } } }));
+  },
+  failStream(id, text) {
+    const session = get().sessions[id];
+    if (session) {
+      const last = session.messages.at(-1);
+      const messages = last?.role === MessageType.Assistant && !last.content ? session.messages.slice(0, -2) : session.messages;
+      set((state) => ({ sessions: { ...state.sessions, [id]: { ...session, messages, failedText: text } } }));
+    }
+  },
+  takeFailedText(id) {
+    const session = get().sessions[id];
+    const text = session?.failedText;
+    if (text !== undefined) set((state) => ({ sessions: { ...state.sessions, [id]: { ...session, failedText: undefined } } }));
+    return text;
+  },
+}));
diff --git a/web/src/pages/next-chats/chat-stream/utils.ts b/web/src/pages/next-chats/chat-stream/utils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2b6d68c0ea282e8f305e4a85f2120f2829597c5
--- /dev/null
+++ b/web/src/pages/next-chats/chat-stream/utils.ts
@@ -0,0 +1,9 @@
+import type { CompletionChunk } from '@/services/chat-completion-stream';
+
+export function mergeAnswerChunk(previous: string, chunk: CompletionChunk) {
+  const incoming = chunk.final && previous ? '' : chunk.answer ?? '';
+  let answer = previous && incoming.startsWith(previous) ? incoming : previous + incoming;
+  if (chunk.start_to_think) answer += '<think>';
+  if (chunk.end_to_think) answer += '</think>';
+  return answer;
+}
