+}
+func (p *wikiPipeline) buildModeAPlan() wikiPlan {
+	return normalizeWikiPlan(wikiPlan{Pages: buildWikiFallbackPages(p.reduced)}, p.docID, p.reduced)
+}
+func cosine32(a, b []float32) float64 {
+	if len(a) != len(b) || len(a) == 0 {
+		return 0
+	}
+	var dot, aa, bb float64
+	for i, v := range a {
+		x, y := float64(v), float64(b[i])
+		dot += x * y
+		aa += x * x
+		bb += y * y
+	}
+	if aa == 0 || bb == 0 {
+		return 0
+	}
+	return dot / math.Sqrt(aa*bb)
+}
+
+// Entity aliases are exact evidence. Embedding similarity only nominates a
+// pair for explicit model disambiguation and never merges identities alone.
+func (p *wikiPipeline) dedupeEntities(entities []wikiEntity) []wikiEntity {
+	if len(entities) < 2 {
+		return entities
+	}
+	var vectors [][]float32
+	if p.deps.Embed != nil {
+		texts := make([]string, len(entities))
+		for i, e := range entities {
+			texts[i] = e.Name + " " + e.Type
+		}
+		vectors, _ = p.deps.Embed.Encode(p.ctx, texts)
+	}
+	out := []wikiEntity{}
+	indexes := []int{}
+	for i, e := range entities {
+		match := -1
+		for j, prev := range out {
+			if prev.Type != "" && e.Type != "" && normKey(prev.Type) != normKey(e.Type) {
+				continue
+			}
+			same := normKey(prev.Name) == normKey(e.Name)
+			for _, alias := range prev.Aliases {
