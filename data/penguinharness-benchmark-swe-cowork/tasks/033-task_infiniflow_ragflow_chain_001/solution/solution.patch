+// Preserve the Go chunker's existing bounded strategy while permitting callers
+// to opt into the soft OVER_CAP policy. Counts use the actual joined text.
+func mergeStrictUnits(units []schema.ChunkDoc, target int, overlapPct float64, joinSep string) []schema.ChunkDoc {
+	if overlapPct < 0 {
+		overlapPct = 0
+	}
+	if overlapPct > 100 {
+		overlapPct = 100
+	}
+	var merged []schema.ChunkDoc
+	add := func(ck schema.ChunkDoc) {
+		ck.TKNums = intPtr(tokenizeStr(ck.Text))
+		if len(merged) == 0 || merged[len(merged)-1].CKType != "text" {
+			merged = append(merged, cloneChunkDoc(ck))
+			return
+		}
+		prev := &merged[len(merged)-1]
+		joined := prev.Text + joinSep + ck.Text
+		if prev.Text == "" {
+			joined = ck.Text
+		}
+		if n := tokenizeStr(joined); n <= target {
+			prev.Text = joined
+			prev.TKNums = intPtr(n)
+			prev.PDFPositions = extendRawJSONArray(prev.PDFPositions, ck.PDFPositions)
+			prev.Positions = extendRawJSONArray(prev.Positions, ck.Positions)
+			return
+		}
+		cp := cloneChunkDoc(ck)
+		if overlapPct > 0 {
+			overlap, _ := computeOverlapPrefix(prev.Text, overlapPct)
+			candidate := overlap + cp.Text
+			if n := tokenizeStr(candidate); n <= target {
+				cp.Text = candidate
+				cp.TKNums = intPtr(n)
+			}
+		}
+		merged = append(merged, cp)
+	}
+	for _, ck := range units {
+		if ck.CKType != "text" {
+			merged = append(merged, cloneChunkDoc(ck))
+			continue
+		}
+		if target <= 0 || tokenizeStr(ck.Text) <= target {
+			add(ck)
+			continue
+		}
+		for _, piece := range splitOversizedUnit(ck.Text, target) {
+			// Token counts are not additive across joins. Recheck every emitted
+			// piece with the real tokenizer before accepting the strict budget.
+			for _, bounded := range splitAtomByTokenBudget(piece, target, tokenizeStr) {
+				cp := cloneChunkDoc(ck)
+				cp.Text = bounded
+				add(cp)
+				ck.PDFPositions = nil
+				ck.Positions = nil
+			}
+		}
+	}
+	return merged
+}
