+			}
+			if !same && len(vectors) == len(entities) && p.deps.Chat != nil && cosine32(vectors[indexes[j]], vectors[i]) >= 0.90 {
+				answer, err := common.GenJSON(p.ctx, p.deps.Chat, common.ChatRequest{LLMID: p.llmID, SystemPrompt: `Decide whether these names refer to the same entity. Return {"same_entity":true} only for the same real identity; related entities are different.`, UserPrompt: mustPrettyJSON([]wikiEntity{prev, e})})
+				if err == nil {
+					same, _ = answer["same_entity"].(bool)
+				}
+			}
+			if same {
+				match = j
+				break
+			}
+		}
+		if match < 0 {
+			out = append(out, e)
+			indexes = append(indexes, i)
+			continue
+		}
+		target := &out[match]
+		target.Aliases = mergeStrings(target.Aliases, append(e.Aliases, e.Name))
+		target.SourceChunkIDs = mergeStrings(target.SourceChunkIDs, e.SourceChunkIDs)
+		// Keep the surviving name in claims and relations, so the evidence remains
+		// discoverable by the page generated for that identity.
+		for j := range p.reduced.Claims {
+			if normKey(p.reduced.Claims[j].Subject) == normKey(e.Name) {
+				p.reduced.Claims[j].Subject = target.Name
+			}
+		}
+		for j := range p.reduced.Relations {
+			rel := &p.reduced.Relations[j]
+			if normKey(rel.From) == normKey(e.Name) {
+				rel.From = target.Name
+			}
