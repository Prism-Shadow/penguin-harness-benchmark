+}
+func normalizeWikiPlanPageLinks(pages []wikiPlanPage) []wikiPlanPage {
+	for i := range pages {
+		pages[i].RelatedKB = uniqueStrings(pages[i].RelatedKB)
+	}
+	return pages
+}
+func canonicalWikiSlug(slug string, pageTypes map[string]string) string {
+	slug = strings.TrimSpace(slug)
+	if strings.Contains(slug, "/") {
+		return slug
+	}
+	if typ := pageTypes[slug]; typ != "" {
+		return typ + "/" + slug
+	}
+	for known := range pageTypes {
+		if lastPathSlug(known) == slug {
+			return known
+		}
+	}
+	return slug
+}
+func appendWikiSeeAlso(content string, outlinks, related []string, kb string, titles, types map[string]string) (string, []string) {
+	seen := map[string]bool{}
+	for _, link := range outlinks {
+		seen[link] = true
+	}
+	lines := []string{}
+	for _, link := range related {
+		slug := canonicalWikiSlug(link, types)
+		if slug == "" || seen[slug] {
+			continue
+		}
+		seen[slug] = true
+		outlinks = append(outlinks, slug)
+		title := firstNonEmpty(titles[link], titles[slug], lastPathSlug(slug))
+		lines = append(lines, "- ["+title+"](artifact/"+kb+"/"+slug+")")
+	}
+	if len(lines) > 0 {
+		content += "\n\n## See also\n\n" + strings.Join(lines, "\n")
+	}
+	return content, outlinks
+}
