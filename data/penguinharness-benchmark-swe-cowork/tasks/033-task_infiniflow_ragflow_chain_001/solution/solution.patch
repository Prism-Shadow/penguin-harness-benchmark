+func (p *wikiPipeline) runKey() string { return firstNonEmpty(p.docID, p.datasetID) }
+func extractRelationDebug(extracts []wikiExtract) []string {
+	var out []string
+	for i, ex := range extracts {
+		for _, r := range ex.Relations {
+			out = append(out, fmt.Sprintf("batch%d:%s", i, relationDebug(r)))
+		}
