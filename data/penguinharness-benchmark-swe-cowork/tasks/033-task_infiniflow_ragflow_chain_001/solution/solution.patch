diff --git a/internal/agent/harness/wiki.go b/internal/agent/harness/wiki.go
new file mode 100644
index 0000000000000000000000000000000000000000..c098b078035e0d5cbb65867f65eb701d71c89ce7
--- /dev/null
+++ b/internal/agent/harness/wiki.go
@@ -0,0 +1,122 @@
+package harness
+
+import (
+	"context"
+	"fmt"
+	"log"
+	"strings"
+
+	"ragflow/internal/engine"
+	"ragflow/internal/engine/types"
+	"ragflow/internal/service"
+)
+
+// wikiSearchService keeps wiki retrieval and source backfill bound to the same
+// tenant and dataset scope as the production runner.
+type wikiSearchService interface {
+	Available(context.Context, string, []string) (bool, error)
+	Search(context.Context, string, []string, string, string) ([]map[string]interface{}, error)
+	BackfillChunks(context.Context, string, []string, []string) ([]map[string]interface{}, error)
+}
+
+type documentWikiSearch struct{ store engine.DocEngine }
+
+func (s documentWikiSearch) documentEngine() engine.DocEngine {
+	if s.store != nil {
+		return s.store
+	}
+	return engine.Get()
+}
+
+func (s documentWikiSearch) request(ctx context.Context, tenant string, datasets []string, query string, limit int) (*types.SearchResult, error) {
+	if strings.TrimSpace(tenant) == "" || len(datasets) == 0 {
+		return nil, fmt.Errorf("wiki search requires tenant and dataset scope")
+	}
+	store := s.documentEngine()
+	if store == nil {
+		return nil, fmt.Errorf("document engine is not initialized")
+	}
+	scope := append([]string(nil), datasets...)
+	request := &types.SearchRequest{
+		IndexNames: []string{"ragflow_" + tenant}, KbIDs: scope, Limit: limit,
+		Filter: map[string]interface{}{"kb_id": scope, "compile_kwd": []string{service.CompileKwdWikiPage}},
+	}
+	if strings.TrimSpace(query) != "" {
+		request.MatchExprs = []interface{}{&types.MatchTextExpr{
+			Fields: []string{"title_tks^10", "content_ltks"}, MatchingText: query, TopN: limit,
+		}}
+	}
+	return store.Search(ctx, request)
+}
+
+func (s documentWikiSearch) Available(ctx context.Context, tenant string, datasets []string) (bool, error) {
+	result, err := s.request(ctx, tenant, datasets, "", 1)
+	if err != nil || result == nil {
+		return false, err
+	}
+	return result.Total > 0 || len(result.Chunks) > 0, nil
+}
+
+func (s documentWikiSearch) Search(ctx context.Context, tenant string, datasets []string, query, keywords string) ([]map[string]interface{}, error) {
+	text := strings.TrimSpace(query + " " + keywords)
+	if text == "" {
+		return nil, nil
+	}
+	result, err := s.request(ctx, tenant, datasets, text, 12)
+	if err != nil || result == nil {
+		return nil, err
+	}
+	return result.Chunks, nil
+}
+
+func (s documentWikiSearch) BackfillChunks(ctx context.Context, tenant string, datasets, identifiers []string) ([]map[string]interface{}, error) {
+	if strings.TrimSpace(tenant) == "" || len(datasets) == 0 {
+		return nil, fmt.Errorf("wiki backfill requires tenant and dataset scope")
+	}
+	store := s.documentEngine()
+	if store == nil {
+		return nil, fmt.Errorf("document engine is not initialized")
+	}
+	chunks := make([]map[string]interface{}, 0, len(identifiers))
+	for _, id := range identifiers {
+		raw, err := store.GetChunk(ctx, "ragflow_"+tenant, id, append([]string(nil), datasets...))
+		if err != nil {
+			continue
+		} // Missing source chunks leave the page evidence intact.
+		if chunk, ok := raw.(map[string]interface{}); ok && len(chunk) > 0 {
+			chunks = append(chunks, chunk)
+		}
+	}
+	return chunks, nil
+}
+
+func (r *ProductionRunner) wikiService() wikiSearchService {
+	if r.wikiSvc != nil {
+		return r.wikiSvc
+	}
+	return documentWikiSearch{}
+}
+
+func (r *ProductionRunner) wikiAvailable(ctx context.Context) bool {
+	available, err := r.wikiService().Available(ctx, r.tenantID, r.datasetIDs)
+	return err == nil && available
+}
+
+func (r *ProductionRunner) wikiSearch(ctx context.Context, query, keywords string) ([]map[string]interface{}, []map[string]interface{}) {
+	chunks, err := r.wikiService().Search(ctx, r.tenantID, r.datasetIDs, query, keywords)
+	if err != nil {
+		log.Printf("agentic_rag: wiki search failed: %v", err)
+		return nil, nil
+	}
+	return r.expandCompiledEvidence(ctx, chunks, nil)
+}
+
+func (r *ProductionRunner) wikiPreferredSearchFn(hybrid SearchFn) SearchFn {
+	return func(ctx context.Context, query, keywords string) ([]map[string]interface{}, []map[string]interface{}) {
+		chunks, aggregates := r.wikiSearch(ctx, query, keywords)
+		if len(chunks) > 0 {
+			return chunks, aggregates
+		}
+		return hybrid(ctx, query, keywords)
+	}
+}
