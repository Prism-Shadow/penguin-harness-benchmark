+
+import { loadJQuery, moduleNamespaceEntry, selectorNativeEntry } from "./loader.mjs";
+
+async function productionModule(probes) {
+	assert.ok(process.env.SEGPIPE_PACKAGE_DIR, "shared production build/pack setup is required");
+	for (const probe of probes) {
+		await promisify(execFile)(process.execPath, [fileURLToPath(new URL("./module-case.mjs", import.meta.url)), probe], {
+			env: process.env,
+			timeout: 30000
+		});
+	}
+}
+
+function repoPath(value) {
+	return path.resolve(value || process.env.REPO_DIR || ".");
+}
+
+async function mustHave(repo, relativePath) {
+	try {
+		await fs.access(path.join(repo, relativePath));
+	} catch {
+		throw new assert.AssertionError({ message: `the production entry ${relativePath} is not available at this stage` });
+	}
+}
+
+async function withRuntime(repo, options, callback) {
+	const runtime = await loadJQuery(repo, options);
+	try {
+		return await callback(runtime);
+	} finally {
+		await runtime.close();
+	}
+}
