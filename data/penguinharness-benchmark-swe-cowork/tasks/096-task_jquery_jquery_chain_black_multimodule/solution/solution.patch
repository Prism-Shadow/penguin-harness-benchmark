diff --git a/build/release.cjs b/build/release.cjs
new file mode 100644
index 0000000..b49656a
--- /dev/null
+++ b/build/release.cjs
@@ -0,0 +1,85 @@
+"use strict";
+
+const fs = require( "node:fs/promises" );
+const path = require( "node:path" );
+const { rollup } = require( "rollup" );
+const pkg = require( "../package.json" );
+const root = path.resolve( __dirname, ".." );
+
+async function build( slim ) {
+
+	const suffix = slim ? ".slim" : "";
+	const excluded = /^(?:ajax(?:\/|\.js$)|callbacks\.js$|deferred(?:\/|\.js$)|effects(?:\/|\.js$)|queue(?:\/|\.js$)|manipulation\/_evalUrl\.js$|deprecated\/ajax-event-alias\.js$)/;
+	const bundle = await rollup( {
+		input: path.join( root, "src/jquery.js" ),
+		plugins: slim ? [ {
+			name: "slim-modules",
+			async load( filename ) {
+				const relative = path.relative( path.join( root, "src" ), filename );
+				if ( relative === "core/ready.js" ) {
+					return fs.readFile( path.join( root, "src/core/ready-no-deferred.js" ), "utf8" );
+				}
+				return excluded.test( relative ) ? "" : null;
+			}
+		} ] : [],
+		onwarn( warning, warn ) {
+			if ( warning.code !== "CIRCULAR_DEPENDENCY" ) {
+				warn( warning );
+			}
+		}
+	} );
+	let compiled;
+	try {
+		const result = await bundle.generate( { format: "iife", name: "jQueryModule", exports: "named" } );
+		compiled = result.output[ 0 ].code + "\nvar jQuery = jQueryModule.jQuery;\n";
+	} finally {
+		if ( bundle.close ) {
+			await bundle.close();
+		}
+	}
+	for ( const [ template, output ] of [
+		[ "wrapper.js", `dist/jquery${ suffix }.js` ],
+		[ "wrapper-esm.js", `dist-module/jquery${ suffix }.module.js` ],
+		[ "wrapper-factory.js", `dist/jquery.factory${ suffix }.js` ],
+		[ "wrapper-factory-esm.js", `dist-module/jquery.factory${ suffix }.module.js` ]
+	] ) {
+		const input = path.join( root, "src", template );
+		const source = await fs.readFile( input, "utf8" );
+		let code;
+		if ( /^[\t ]*\/\/ @CODE\s*$/m.test( source ) ) {
+			code = source.replace( /^[\t ]*\/\/ @CODE\s*$/m, () => compiled );
+		} else {
+			const nativeBundle = await rollup( { input } );
+			try {
+				const result = await nativeBundle.generate( { format: output.startsWith( "dist-module" ) ? "esm" : "cjs" } );
+				code = result.output[ 0 ].code;
+			} finally {
+				if ( nativeBundle.close ) {
+					await nativeBundle.close();
+				}
+			}
+		}
+		code = code.replace( /@VERSION/g, pkg.version + ( slim ? " slim" : "" ) )
+			.replace( /@DATE/g, new Date().toISOString() );
+		await fs.writeFile( path.join( root, output ), code );
+	}
+}
+
+async function main() {
+	for ( const directory of [ "dist", "dist-module" ] ) {
+		await fs.mkdir( path.join( root, directory ), { recursive: true } );
+		for ( const filename of await fs.readdir( path.join( __dirname, "wrappers", directory ) ) ) {
+			if ( directory === "dist-module" && filename === ".eslintrc.json" ) {
+				continue;
+			}
+			await fs.copyFile( path.join( __dirname, "wrappers", directory, filename ), path.join( root, directory, filename === "eslint-template.json" ? ".eslintrc.json" : filename ) );
+		}
+	}
+	await build( false );
+	await build( true );
+}
+
+main().catch( error => {
+	console.error( error );
+	process.exitCode = 1;
+} );
