+// Icons appear left of the node title
+export const NODE_TYPE_TITLE_ICON: { [nodeType: string]: IIconProps['icon'] } = {
+  http_service: faCloud,
+  http_operation: faBullseye,
+  http_webhook: faEnvelope,
+  model: faCube,
+};
+
+export const NODE_GROUP_ICON: { [itemType: string]: IIconProps['icon'] } = {
+  http_webhook: faEnvelopesBulk,
+  model: faCubes,
+};
+
+// Icons appear in the right meta
+export const NODE_TYPE_META_ICON: { [nodeType: string]: IIconProps['icon'] } = {
+  webhook: faEnvelope,
+  model: faCube,
+};
+
+export const NODE_TYPE_ICON_COLOR: ColorMap = {
+  model: 'warning',
+  http_webhook: 'primary',
+};
+
+// Literal CSS colors use style; Mosaic's color prop accepts theme tokens.
+export const NODE_TYPE_ICON_STYLE: Partial<Record<string, CSSProperties>> = {
+  http_service: { color: '#D812EA' },
+  http_operation: { color: '#9747FF' },
+};
+
+export const NODE_GROUP_ICON_COLOR: ColorMap = {
+  http_webhook: 'primary',
+  model: 'warning',
+};
+
+export const NODE_META_COLOR: ColorMap = {
+  get: 'success',
+  post: 'primary',
+  put: 'warning',
+  patch: 'warning',
+  delete: 'danger',
+};
