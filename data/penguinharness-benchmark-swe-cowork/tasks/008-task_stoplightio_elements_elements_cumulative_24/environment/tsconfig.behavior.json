{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "../packages",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "jsx": "react",
    "lib": ["es2019", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@stoplight/elements": ["./elements/src"],
      "@stoplight/elements/*": ["./elements/src/*"],
      "@stoplight/elements-dev-portal": ["./elements-dev-portal/src"],
      "@stoplight/elements-dev-portal/*": ["./elements-dev-portal/src/*"],
      "@stoplight/elements-core": ["./elements-core/src"],
      "@stoplight/elements-core/*": ["./elements-core/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "es6"
  }
}
