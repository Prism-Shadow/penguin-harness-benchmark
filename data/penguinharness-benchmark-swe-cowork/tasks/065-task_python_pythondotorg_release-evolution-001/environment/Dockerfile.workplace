FROM harbor.tokenwave.us/release/cowork-bench/065-workplace@sha256:da3d306bbca33cf23a8b9763444f08bc84994c3a6c6c1b08b237d7d90b704cde
USER root
COPY workplace-service/semantic_colleague.py /usr/local/bin/semantic_colleague.py
COPY workplace-service/harbor_dynamic_colleague_adapter.py /usr/local/bin/harbor_dynamic_colleague_adapter.py
COPY workplace-service/workplace-sidecar /usr/local/bin/workplace-sidecar
RUN chmod 755 /usr/local/bin/workplace-sidecar
COPY workplace-service/original/ /opt/workplace/original/
ENV TOKENWAVE_ORIGINAL_ROOT=/opt/workplace/original
