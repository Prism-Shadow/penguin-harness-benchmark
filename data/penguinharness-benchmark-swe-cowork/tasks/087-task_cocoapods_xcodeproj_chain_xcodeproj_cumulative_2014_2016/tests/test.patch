+        refute_equal Process.pid, load_pid
+        write_pid = events.find { |event| event[0] == 'xml' }[1].to_i
+        assert_equal(failure ? Process.pid : load_pid, write_pid)
+        assert_includes File.read(path), '&#38634;' if failure
+      end
+    end
+  end
+end
