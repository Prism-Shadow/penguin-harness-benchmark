+
+    /**
+     * Generate the name of the referenced table property in the Refs wrapper class.
+     */
+    public fun getRefTablePropertyName(c: KSClassDeclaration, prop: KSPropertyDeclaration, ref: TableMetadata): String {
+        return getRefColumnPropertyNameForRefs(c, prop, ref)
+    }
+
+    public fun getRefColumnPropertyNameForRefs(
+        c: KSClassDeclaration, prop: KSPropertyDeclaration, ref: TableMetadata
+    ): String {
+        return prop.simpleName.asString()
+    }
+}
