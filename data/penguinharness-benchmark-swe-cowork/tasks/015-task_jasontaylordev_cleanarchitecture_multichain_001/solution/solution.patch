+import { defineConfig } from 'vite';
+import react from '@vitejs/plugin-react';
+
+const target =
+  process.env['services__webapi__https__0'] ||
+  process.env['services__webapi__http__0'];
+
+const proxyOptions = target
+  ? { target, secure: false, changeOrigin: true }
+  : undefined;
+
+// https://vitejs.dev/config/
+export default defineConfig({
+  plugins: [react()],
+  server: {
+    port: parseInt(process.env.PORT!),
+    proxy: proxyOptions
+      ? {
+          '/api': proxyOptions,
+          '/openapi': proxyOptions,
+          '/scalar': proxyOptions,
+          '/weatherforecast': proxyOptions,
+          '/WeatherForecast': proxyOptions,
+        }
+      : undefined,
+  },
+  build: {
+    outDir: 'build',
+  },
+});
diff --git a/src/Web/ClientApp/Dockerfile b/src/Web/ClientApp/Dockerfile
