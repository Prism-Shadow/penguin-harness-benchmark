+using Microsoft.AspNetCore.OpenApi;
+using Microsoft.OpenApi;
+
+namespace CleanArchitecture.Web.Infrastructure;
+
+/// <summary>
+/// Adds human-readable summaries and descriptions to the ASP.NET Core Identity endpoints
+/// registered by <c>MapIdentityApi</c>. Those endpoints are generated by the framework and
+/// cannot be annotated with <see cref="EndpointSummaryAttribute"/> or
+/// <see cref="EndpointDescriptionAttribute"/> directly, so metadata is applied here by
+/// matching on the operation's relative path (and HTTP method for ambiguous paths).
+/// </summary>
