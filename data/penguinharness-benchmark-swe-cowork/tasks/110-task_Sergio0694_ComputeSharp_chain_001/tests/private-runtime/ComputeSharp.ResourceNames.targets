<Project>
  <Target Name="PreserveComputeSharpEmbeddedResourceName" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'ComputeSharp.Core.SourceGenerators'">
    <ItemGroup>
      <EmbeddedResource Update="EmbeddedResources/GlobalUsingDirectives.cs">
        <LogicalName>ComputeSharp.Core.SourceGenerators.EmbeddedResources.GlobalUsingDirectives.cs</LogicalName>
        <ManifestResourceName>ComputeSharp.Core.SourceGenerators.EmbeddedResources.GlobalUsingDirectives.cs</ManifestResourceName>
      </EmbeddedResource>
      <_CoreCompileResourceInputs Update="@(_CoreCompileResourceInputs)"
          Condition="'%(_CoreCompileResourceInputs.Filename)%(_CoreCompileResourceInputs.Extension)' == 'GlobalUsingDirectives.cs'">
        <LogicalName>ComputeSharp.Core.SourceGenerators.EmbeddedResources.GlobalUsingDirectives.cs</LogicalName>
        <ManifestResourceName>ComputeSharp.Core.SourceGenerators.EmbeddedResources.GlobalUsingDirectives.cs</ManifestResourceName>
      </_CoreCompileResourceInputs>
    </ItemGroup>
  </Target>
</Project>
