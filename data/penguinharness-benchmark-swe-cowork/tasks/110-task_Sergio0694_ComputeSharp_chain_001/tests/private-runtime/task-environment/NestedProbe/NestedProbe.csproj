<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoDir Condition="'$(RepoDir)' == ''">/workspace</RepoDir>
    <Deterministic>true</Deterministic>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoDir)/src/ComputeSharp.Core/ComputeSharp.Core.csproj" />
    <ProjectReference Include="$(RepoDir)/src/ComputeSharp.Core.SourceGenerators/ComputeSharp.Core.SourceGenerators.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
      <AdditionalProperties>DefineConstants=SOURCE_GENERATOR;IsPublishedProject=true;IsSourceGeneratorProject=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(RepoDir)/src/ComputeSharp.D2D1/ComputeSharp.D2D1.csproj" />
    <ProjectReference Include="$(RepoDir)/src/ComputeSharp.D2D1.SourceGenerators/ComputeSharp.D2D1.SourceGenerators.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
      <AdditionalProperties>DefineConstants=SOURCE_GENERATOR;IsPublishedProject=true;IsSourceGeneratorProject=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
