+                    <Property name='ConstantBuffer' type='blob'>
+                        <Property name='DisplayName' type='string' value='ConstantBuffer'/>
+                    </Property>
+                    <Property name='TransformMapper' type='iunknown'>
+                        <Property name='DisplayName' type='string' value='TransformMapper'/>
+                    </Property>
