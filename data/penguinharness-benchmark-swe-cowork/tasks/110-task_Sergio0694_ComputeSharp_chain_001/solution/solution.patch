+            for (int i = 0; i < resourceTextureCount; i++)
+            {
+                _ = builder.Append('\n');
+                _ = builder.Append($"""
+                    <Property name='ResourceTextureManager{i}' type='iunknown'>
+                        <Property name='DisplayName' type='string' value='ResourceTextureManager{i}'/>
+                    </Property>
+                """);
+            }
