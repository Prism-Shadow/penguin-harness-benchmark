+    OutboundToInbound,
+}
+
+#[derive(Clone, Copy)]
+enum RelayOperation {
+    Read,
+    Write,
+    Flush,
+    Shutdown,
+}
+
+impl RelayReader {
+    fn new(inner: OwnedReadHalf, context: RelayContext) -> Self {
+        Self { inner, context }
