--- /dev/null
+++ b/mobile/src/main/rust/vpnhotspotd/tests/reference_wire_compat.rs
@@ -0,0 +1,68 @@
+use prost::Message;
+use vpnhotspotd::shared::proto::daemon;
+use vpnhotspotd::shared::protocol::{
+    neighbour_monitor_update_frame, traffic_counter_snapshot_frame,
+};
+
+#[test]
+fn extended_counter_reply_keeps_legacy_lines() {
+    let lines = vec!["17 201 ACCEPT all -- wlan7 * 192.0.2.9 0.0.0.0/0".into()];
+    let packet = traffic_counter_snapshot_frame(
+        19,
+        lines.clone(),
+        vec![daemon::TrafficCounter {
+            downstream: "wlan7".into(),
+            sent_bytes: 201,
+            ..Default::default()
+        }],
+    );
+    let decoded = daemon::DaemonEnvelope::decode(packet.as_slice()).unwrap();
+    let Some(daemon::daemon_envelope::Frame::Reply(reply)) = decoded.frame else {
+        panic!("reply")
+    };
+    let Some(daemon::reply_frame::Payload::TrafficCounterLines(legacy)) = reply.payload else {
+        panic!("legacy payload")
+    };
+    assert_eq!(legacy.lines, lines);
+    assert_eq!(reply.traffic_counters.unwrap().counters[0].sent_bytes, 201);
+}
+
+#[test]
+fn extended_neighbour_event_keeps_legacy_deltas() {
+    let deltas = vec![daemon::NeighbourDelta {
+        delta: Some(daemon::neighbour_delta::Delta::Delete(
+            daemon::NeighbourDelete {
+                address: vec![192, 0, 2, 9],
+                dev: "eth8".into(),
+            },
+        )),
+    }];
+    let packet = neighbour_monitor_update_frame(
+        21,
+        deltas.clone(),
+        Some(daemon::LinkTopologySnapshot {
+            bridges: vec![daemon::BridgeInterface {
+                name: "bridge7".into(),
+                members: vec!["eth8".into()],
+            }],
+        }),
+    );
+    let decoded = daemon::DaemonEnvelope::decode(packet.as_slice()).unwrap();
+    let Some(daemon::daemon_envelope::Frame::Event(event)) = decoded.frame else {
+        panic!("event")
+    };
+    let Some(daemon::event_frame::Payload::NeighbourDeltas(legacy)) = event.payload else {
+        panic!("legacy payload")
+    };
+    assert_eq!(legacy.deltas, deltas);
+    assert_eq!(
+        event
+            .neighbour_monitor
+            .unwrap()
+            .link_topology
+            .unwrap()
+            .bridges[0]
+            .members,
+        vec!["eth8"]
+    );
+}
