 pub(crate) async fn await_connect(socket: &Socket) -> io::Result<()> {
     await_writable(socket.as_fd()).await?;
@@ -15,12 +17,109 @@ pub(crate) async fn await_writable(fd: BorrowedFd<'_>) -> io::Result<()> {
