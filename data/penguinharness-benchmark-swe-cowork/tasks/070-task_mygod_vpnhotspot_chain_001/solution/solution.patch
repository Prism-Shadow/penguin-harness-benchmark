+    SessionPorts, UpstreamConfig, UpstreamRole, ANDROID_ROUTE_TABLE_LOCAL_NETWORK,
+    DAEMON_INTERCEPT_FWMARK_MASK, DAEMON_INTERCEPT_FWMARK_VALUE, DAEMON_TABLE,
