#!/bin/sh
log=${VPNHOTSPOT_FIREWALL_LOG:-/tmp/vpnhotspot-firewall.log}
input=$(cat)
marker=
case "$input" in
  *"-L bench_chain"*) marker=' -L' ;;
esac
printf 'argv=%s %s%s\n%s\n' "$0" "$*" "$marker" "$input" >> "$log"
case "$input" in
  *"-N bench_chain"*) exit 1 ;;
  *"-L bench_chain"*) printf 'bench_chain\n'; exit 0 ;;
  *) exit 0 ;;
esac
