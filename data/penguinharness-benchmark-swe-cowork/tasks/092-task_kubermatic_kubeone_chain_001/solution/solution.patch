+      tolerations:
+      - operator: Exists
+      volumes:
+      - name: azure-cred
+        secret:
+          items:
+          - key: cloud-config
+            path: azure.json
+          secretName: cloud-config
+      - hostPath:
+          path: /var/lib/kubelet/plugins/disk.csi.azure.com
+          type: DirectoryOrCreate
+        name: socket-dir
+      - hostPath:
+          path: /var/lib/kubelet/
+          type: DirectoryOrCreate
+        name: mountpoint-dir
+      - hostPath:
+          path: /var/lib/kubelet/plugins_registry/
+          type: DirectoryOrCreate
+        name: registration-dir
+      - hostPath:
+          path: /dev
+          type: Directory
+        name: device-dir
+      - hostPath:
