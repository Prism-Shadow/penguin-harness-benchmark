diff --git a/pkg/tasks/files.go b/pkg/tasks/files.go
new file mode 100644
index 0000000000000000000000000000000000000000..ada1389b4d3ba56393d8a6a077cfdd47464d8915
--- /dev/null
+++ b/pkg/tasks/files.go
@@ -0,0 +1,143 @@
+/*
