+        livenessProbe:
+          failureThreshold: 5
+          httpGet:
+            host: localhost
+            path: /healthz
+            port: 29603
+          initialDelaySeconds: 30
+          periodSeconds: 30
+          timeoutSeconds: 10
+        name: azuredisk
+        resources:
+          limits:
+            memory: 200Mi
+          requests:
+            cpu: 10m
+            memory: 20Mi
+        securityContext:
+          capabilities:
+            drop:
+            - ALL
+          privileged: true
+        volumeMounts:
+        - mountPath: /csi
+          name: socket-dir
+        - mountPath: /var/lib/kubelet/
+          mountPropagation: Bidirectional
+          name: mountpoint-dir
+        - mountPath: /etc/kubernetes/
+          name: azure-cred
+        - mountPath: /dev
