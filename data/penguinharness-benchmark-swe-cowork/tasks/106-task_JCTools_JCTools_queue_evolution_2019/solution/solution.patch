+                Arrays.fill(sequence, AtomicChunk.NIL_CHUNK_INDEX);
+            }
+            else
+            {
+                sequence = null;
+            }
+        }
+
+        final boolean isPooled()
+        {
+            return sequence != null;
+        }
+
+        private static long calcSequenceOffset(long index)
+        {
