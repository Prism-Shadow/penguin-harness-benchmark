+  const Peer = await load('lib/peer.js')
+  assert.equal(typeof Peer.createTCPOutgoingPeer, 'function')
+} else {
+  throw new Error(`unknown probe mode ${mode}`)
+}
+
+console.log(`behavior ${mode} passed`)
