+{{- $enabledPriorityPlaybooks = append $enabledPriorityPlaybooks $myplaybook }}
+{{- end }}
+{{- end }}
+
+{{- if $enabledPriorityPlaybooks }}
+{{ toYaml $enabledPriorityPlaybooks | indent 2 }}
 {{- end }}
 
 {{- if .Values.customPlaybooks }}
