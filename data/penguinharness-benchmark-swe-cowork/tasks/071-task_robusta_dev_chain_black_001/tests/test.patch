+    calls = []
+
+    class Query:
+        def update(self, payload):
+            calls.append(("update", payload))
+            return self
+
+        def eq(self, *args):
+            calls.append(("eq", args))
+            return self
+
+        def execute(self):
+            calls.append(("execute",))
+            return self
+
+    class Client:
+        def table(self, name):
+            calls.append(("table", name))
+            return Query()
+
+    dal.client = Client()
+    dal.handle_supabase_error = lambda: None
+    dal.set_cluster_active(False)
+    assert calls[0] == ("table", "ClustersStatus")
+    assert ("update", {"active": False, "updated_at": "now()"}) in calls
+    assert ("execute",) in calls
