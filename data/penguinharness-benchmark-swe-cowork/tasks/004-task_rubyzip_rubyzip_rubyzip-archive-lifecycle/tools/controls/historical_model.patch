+module Zip
+  module Dirtyable
+    def dirty?
+      !!@dirty || (!!@clean_archive_state && archive_state != @clean_archive_state)
+    end
+
+    alias dirty dirty?
+
+    def mark_dirty!
+      @dirty = true
+    end
+
+    def mark_clean!
+      @clean_archive_state = archive_state
+      @clean_local_header_state = local_header_state
+      @dirty = false
+    end
+  end
+end
