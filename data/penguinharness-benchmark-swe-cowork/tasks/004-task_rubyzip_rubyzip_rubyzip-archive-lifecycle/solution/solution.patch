+# frozen_string_literal: true
+
+module Zip
+  module LegacyArguments
+    def self.options(values, names, keywords)
+      raise ArgumentError, 'too many positional arguments' if values.length > names.length
+
+      names.zip(values).first(values.length).to_h.merge(keywords)
+    end
+
+    module Archive
+      def initialize(path, *legacy, **keywords)
+        options = legacy.length == 3 ? legacy.pop.dup : {}
+        super(path, **LegacyArguments.options(legacy, [:create, :buffer], options.merge(keywords)))
+      end
+
+      def get_output_stream(entry, *legacy, **keywords, &block)
+        names = [:permissions, :comment, :extra, :compressed_size, :crc, :compression_method, :size, :time]
+        options = LegacyArguments.options(legacy, names, keywords).reject { |_, value| value.nil? }
+        super(entry, **options, &block)
+      end
+
+      def extract(entry, path = nil, **keywords, &block)
+        if path && !keywords.key?(:destination_directory)
+          absolute = ::File.expand_path(path)
+          callback = block && proc { |existing, _destination| block.call(existing, path) }
+          return super(entry, ::File.basename(absolute), destination_directory: ::File.dirname(absolute), &callback)
+        end
+        super(entry, path, **keywords, &block)
+      end
+    end
+
+    module ArchiveClass
+      def split(path, *legacy, **keywords)
+        names = [:segment_size, :delete_original, :partial_zip_file_name]
+        super(path, **LegacyArguments.options(legacy, names, keywords))
+      end
+
+      def open(path, *legacy, **keywords, &block)
+        options = legacy.length == 2 ? legacy.pop.dup : {}
+        super(path, **LegacyArguments.options(legacy, [:create], options.merge(keywords)), &block)
+      end
+
+      def open_buffer(io = ::StringIO.new, *legacy, **keywords, &block)
+        raise ArgumentError, 'too many positional arguments' if legacy.length > 1
+
+        super(io, **(legacy.first || {}).merge(keywords), &block)
+      end
+
+      def add_buffer(&block)
+        open_buffer(::StringIO.new, create: true, &block)
+      end
+    end
+
+    module Input
+      def initialize(context, *legacy, **keywords)
+        super(context, **LegacyArguments.options(legacy, [:offset, :decrypter], keywords))
+      end
+    end
+
+    module InputClass
+      def open(context, *legacy, **keywords, &block)
+        super(context, **LegacyArguments.options(legacy, [:offset, :decrypter], keywords), &block)
+      end
+
+      def open_buffer(context, *legacy, **keywords, &block)
+        super(context, **LegacyArguments.options(legacy, [:offset], keywords), &block)
+      end
+    end
+
+    module Output
+      def initialize(context, *legacy, **keywords)
+        super(context, **LegacyArguments.options(legacy, [:stream, :encrypter], keywords))
+      end
+
+    end
+
+    module OutputClass
+      def open(context, *legacy, **keywords, &block)
+        super(context, **LegacyArguments.options(legacy, [:encrypter], keywords), &block)
+      end
+
+      def write_buffer(context = ::StringIO.new, *legacy, **keywords, &block)
