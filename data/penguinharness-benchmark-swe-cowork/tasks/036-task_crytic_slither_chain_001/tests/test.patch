+"""Compatibility shim for the legacy ``pysha3`` import used by Slither.
+
+Python 3.11 exposes the Keccak-compatible SHA-3 constructors through
+``hashlib``; the old dependency only needs these names for import-time
+compatibility in the selected source revision.
+"""
+
+from hashlib import sha3_224, sha3_256, sha3_384, sha3_512
+
+try:
+    from Crypto.Hash import keccak as _keccak
+except ImportError:  # pragma: no cover - runtime image installs pycryptodome
+    _keccak = None
+
+
+def keccak_256(data=b""):
+    """Compatibility constructor used by the historical Slither helpers."""
+    if _keccak is None:
+        return sha3_256(data)
+    digest = _keccak.new(digest_bits=256)
+    digest.update(data)
+    return digest
+
+__all__ = ["sha3_224", "sha3_256", "sha3_384", "sha3_512", "keccak_256"]
