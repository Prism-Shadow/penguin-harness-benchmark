+            return this;
+        }
+
+        internal override AssetIDType DoTypePropagation(DecompileContext context, AssetIDType suggestedType)
+        {
+            if (Var.Var.AssetType == AssetIDType.Other)
+                Var.Var.AssetType = suggestedType;
+            return Var.Var.AssetType;
