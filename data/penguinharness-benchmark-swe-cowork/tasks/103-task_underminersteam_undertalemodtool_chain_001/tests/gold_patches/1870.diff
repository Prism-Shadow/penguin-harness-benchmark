+    /// <summary>
+    /// Basic private constructor for use by other creation methods; just initializes the given fields.
+    /// </summary>
+    private GMImage(ImageFormat format, int width, int height, byte[] data)
+    {
+        Format = format;
+        Width = width;
+        Height = height;
+        _data = data;
