+    /// Magic value found near the end of a BZip2 stream (square root of pi). 
+    /// </summary>
+    private static ReadOnlySpan<byte> MagicBz2Footer => new byte[] { 0x17, 0x72, 0x45, 0x38, 0x50, 0x90 };
