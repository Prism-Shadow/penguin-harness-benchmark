+    private static final String TEXT_PARSE_MODE_FIELD = "text_parse_mode";
+    private static final String TEXT_ENTITIES_FIELD = "text_entities";
+    private static final String PAY_FOR_UPGRADE_FIELD = "pay_for_upgrade";
+
