+        if (!bytes.length) {
+          return original;
+        }
+      }
+      return {
+        ok: true,
+        body: Buffer.concat(chunks).toString('utf8'),
+        statusCode: resource.httpStatusCode,
+        url,
+      };
+    } catch (error) {
+      this.logger?.info(LogTag.Runtime, 'Browser resource read failed', { url, error });
+      return original;
+    } finally {
+      if (handle) {
+        try {
+          await this.cdp.IO.close({ handle });
+        } catch (error) {
+          this.logger?.info(LogTag.Runtime, 'Browser resource cleanup failed', { url, error });
+        }
+      }
+    }
+  }
 }
