+  /**
+   * Clears temporarily disables maps for the sources.
+   */
+  public clearDisabledSourceMaps(forSource?: ISourceWithMap) {
+    if (forSource) {
+      this._temporarilyDisabledSourceMaps.delete(forSource);
+    } else {
+      this._temporarilyDisabledSourceMaps.clear();
+    }
+  }
