+
+/** Chooses TurboModule first while retaining callback-based legacy modules. */
+class ModuleNegotiator {
+  constructor(options) {
+    const config = options || {};
+    this.prefer = config.prefer || 'turbo';
+  }
+
+  resolve(modules) {
+    const available = modules || {};
+    const turbo = available.turbo || available.turboModule || null;
