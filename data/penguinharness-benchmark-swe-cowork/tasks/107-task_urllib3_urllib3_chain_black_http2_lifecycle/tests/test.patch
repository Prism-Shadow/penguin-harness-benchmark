+        class EmptyChunkStream:
+            closed = False
+
+            def readline(self, amt: int = -1) -> bytes:
+                return b""
+
+            def read(self, amt: int = -1) -> bytes:
+                return b""
+
+            def read1(self, amt: int = -1) -> bytes:
+                return b""
+
+            def flush(self) -> None:
+                return None
+
+            def close(self) -> None:
