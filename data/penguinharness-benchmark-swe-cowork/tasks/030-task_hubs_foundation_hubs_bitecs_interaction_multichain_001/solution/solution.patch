diff --git a/src/bit-systems/snap-media-system.ts b/src/bit-systems/snap-media-system.ts
new file mode 100644
--- /dev/null
+++ b/src/bit-systems/snap-media-system.ts
@@ -0,0 +1,133 @@
+import { defineQuery, entityExists, hasComponent } from "bitecs";
+import { CanvasTexture, Material, Mesh, MeshBasicMaterial, Quaternion, Vector3 } from "three";
+import { HubsWorld } from "../app";
+import { MediaPDF, MediaSnapped, MediaVideo, MediaVideoData, NetworkedPDF, NetworkedVideo } from "../bit-components";
+import { SOUND_CAMERA_TOOL_TOOK_SNAPSHOT } from "../systems/sound-effects-system";
+import { JobRunner } from "../utils/coroutine-utils";
+import { crNextFrame } from "../utils/coroutine";
+import { EntityID } from "../utils/networking-types";
+import { PDFResourcesMap } from "./pdf-system";
+
+type Snapshot = {
+  object: Mesh;
+  position: Vector3;
+  quaternion: Quaternion;
+  scale: Vector3;
+  material: Material | Material[];
+  canvas: HTMLCanvasElement;
+  texture: CanvasTexture;
+  snappedMaterial: MeshBasicMaterial;
+  video?: HTMLVideoElement;
+  time?: number;
+  paused?: boolean;
+  videoFlags?: number;
+  page?: number;
+  networkTime?: number;
+  networkFlags?: number;
+  networkPage?: number;
+};
+
+type SnapState = { jobs: JobRunner<EntityID>; snapshots: Map<EntityID, Snapshot>; active: Set<EntityID> };
+const states = new WeakMap<HubsWorld, SnapState>();
+
+function stateFor(world: HubsWorld) {
+  let state = states.get(world);
+  if (!state) {
+    state = { jobs: new JobRunner<EntityID>(), snapshots: new Map(), active: new Set() };
+    states.set(world, state);
+  }
+  return state;
+}
+
+function restore(world: HubsWorld, eid: EntityID) {
+  const snapshots = stateFor(world).snapshots;
+  const saved = snapshots.get(eid);
+  if (!saved) return;
+  snapshots.delete(eid);
+  saved.object.position.copy(saved.position);
+  saved.object.quaternion.copy(saved.quaternion);
+  saved.object.scale.copy(saved.scale);
+  saved.object.material = saved.material;
+  saved.object.matrixNeedsUpdate = true;
+  if (saved.video) {
+    saved.video.currentTime = saved.time!;
+    if (saved.paused) saved.video.pause();
+    else saved.video.play()?.catch(() => {});
+  }
+  if (entityExists(world, eid)) {
+    if (saved.videoFlags !== undefined) MediaVideo.flags[eid] = saved.videoFlags;
+    if (saved.page !== undefined) MediaPDF.pageNumber[eid] = saved.page;
+    if (saved.networkPage !== undefined) NetworkedPDF.pageNumber[eid] = saved.networkPage;
+    if (saved.networkTime !== undefined) {
+      NetworkedVideo.time[eid] = saved.networkTime;
+      NetworkedVideo.flags[eid] = saved.networkFlags!;
+    }
+  }
+  saved.snappedMaterial.dispose();
+  saved.texture.dispose();
+  saved.canvas.width = 0;
+  saved.canvas.height = 0;
+}
+
+export function* snapMedia(world: HubsWorld, eid: EntityID) {
+  if (!entityExists(world, eid) || !hasComponent(world, MediaSnapped, eid)) return;
+  const object = world.eid2obj.get(eid) as Mesh | undefined;
+  const video = hasComponent(world, MediaVideo, eid) ? MediaVideoData.get(eid) : undefined;
+  const pdf = hasComponent(world, MediaPDF, eid) ? PDFResourcesMap.get(eid) : undefined;
+  const source = video || pdf?.canvas;
+  if (!object?.isMesh || !source) return;
+  const canvas = document.createElement("canvas");
+  canvas.width = video ? video.videoWidth : pdf!.canvas.width;
+  canvas.height = video ? video.videoHeight : pdf!.canvas.height;
+  const context = canvas.getContext("2d");
+  if (!context || !canvas.width || !canvas.height) return;
+  try {
+    context.drawImage(source, 0, 0, canvas.width, canvas.height);
+  } catch {
+    canvas.width = canvas.height = 0;
+    return;
+  }
+  const texture = new CanvasTexture(canvas);
+  const snappedMaterial = new MeshBasicMaterial({ map: texture });
+  const saved: Snapshot = {
+    object, canvas, texture, snappedMaterial, material: object.material,
+    position: object.position.clone(), quaternion: object.quaternion.clone(), scale: object.scale.clone(),
+    video, time: video?.currentTime, paused: video?.paused,
+    videoFlags: video ? MediaVideo.flags[eid] : undefined,
+    page: pdf ? MediaPDF.pageNumber[eid] : undefined,
+    networkTime: hasComponent(world, NetworkedVideo, eid) ? NetworkedVideo.time[eid] : undefined,
+    networkFlags: hasComponent(world, NetworkedVideo, eid) ? NetworkedVideo.flags[eid] : undefined,
+    networkPage: hasComponent(world, NetworkedPDF, eid) ? NetworkedPDF.pageNumber[eid] : undefined
+  };
+  stateFor(world).snapshots.set(eid, saved);
+  object.material = snappedMaterial;
+  video?.pause();
+  try {
+    while (entityExists(world, eid) && hasComponent(world, MediaSnapped, eid)) yield crNextFrame();
+  } finally {
+    restore(world, eid);
+  }
+}
+
+const snappedMediaQuery = defineQuery([MediaSnapped]);
+export function snapMediaSystem(world: HubsWorld, sfxSystem: any) {
+  const state = stateFor(world);
+  const current = new Set(snappedMediaQuery(world));
+  state.active.forEach(eid => {
+    if (!current.has(eid) || !entityExists(world, eid)) {
+      state.jobs.stop(eid);
+      restore(world, eid);
+      state.active.delete(eid);
+    }
+  });
+  current.forEach(eid => {
+    if (state.active.has(eid)) return;
+    state.active.add(eid);
+    const supported = hasComponent(world, MediaVideo, eid) && MediaVideoData.has(eid)
+      || hasComponent(world, MediaPDF, eid) && PDFResourcesMap.has(eid);
+    if (!supported || !(world.eid2obj.get(eid) as Mesh)?.isMesh) return;
+    state.jobs.add(eid, () => snapMedia(world, eid));
+    sfxSystem?.playSoundOneShot?.(SOUND_CAMERA_TOOL_TOOK_SNAPSHOT);
+  });
+  state.jobs.tick();
+}
