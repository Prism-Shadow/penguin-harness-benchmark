+    const schema: any = tablesToSchema(new ModuleContext(), { people: table({ name: 'people' }, { createdAt: t.timestamp() }) });
+    expect(toString(schema.tables.people, eq('createdAt', timestamp))).toBe("createdAt = '2024-01-01T00:00:00.123000Z'");
