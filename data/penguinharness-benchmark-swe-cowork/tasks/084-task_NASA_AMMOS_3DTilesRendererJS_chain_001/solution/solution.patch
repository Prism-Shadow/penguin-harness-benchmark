+/** @import { MVTGlyphAtlasTexture } from './MVTGlyphAtlasTexture.js'; */
+import { BufferAttribute, BufferGeometry, GreaterDepth, Group, Matrix4, Points, Vector2, Vector3, Vector4 } from 'three';
