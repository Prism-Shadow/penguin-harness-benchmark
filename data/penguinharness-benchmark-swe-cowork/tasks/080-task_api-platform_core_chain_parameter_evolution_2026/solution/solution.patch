+    }
+
+    private function formatStartValue(string $value): string
+    {
+        return addcslashes($value, '\\%_').'%';
+    }
+
+    private function formatWordValue(string $value): string
+    {
+        return '% '.addcslashes($value, '\\%_').'%';
+    }
+}
