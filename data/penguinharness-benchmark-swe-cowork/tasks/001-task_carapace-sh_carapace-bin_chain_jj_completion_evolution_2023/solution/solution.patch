diff --git a/pkg/actions/tools/jj/conflict.go b/pkg/actions/tools/jj/conflict.go
new file mode 100644
index 0000000000000000000000000000000000000000..866304b5f8a1c3690f465f10cf99404d17dd4b61
--- /dev/null
+++ b/pkg/actions/tools/jj/conflict.go
@@ -0,0 +1,73 @@
+package jj
+
+import (
+	"os/exec"
+	"strings"
+
+	"github.com/rsteube/carapace"
+)
+
+// ActionConflicts completes conflicts
+func ActionConflicts(revision string) carapace.Action {
+	return carapace.ActionExecCommand("jj", "--color=never", "resolve", "--list", "--revision", revision)(func(output []byte) carapace.Action {
+		if len(output) == 0 {
+			return carapace.ActionValues()
+		}
+		// The conflict table pads paths with spaces. Consult the selected
+		// revision's file names to distinguish padding from a path suffix.
+		return carapace.ActionExecCommand("jj", "--color=never", "files", "--revision", revision)(func(files []byte) carapace.Action {
+			paths := make(map[string][]string)
+			for _, path := range strings.Split(strings.TrimSuffix(string(files), "\n"), "\n") {
+				key := strings.TrimRight(path, " ")
+				paths[key] = append(paths[key], path)
+			}
+			vals := make([]string, 0)
+			batch := carapace.Batch()
+			checked := make(map[string]bool)
+			for _, line := range strings.Split(strings.TrimSuffix(string(output), "\n"), "\n") {
+				index := strings.LastIndex(line, "    ")
+				if index < 0 {
+					return carapace.ActionMessage("cannot parse jj conflict listing")
+				}
+				name, description := strings.TrimRight(line[:index], " "), line[index+4:]
+				switch candidates := paths[name]; len(candidates) {
+				case 0:
+					// The conflict listing remains authoritative if the file
+					// catalogue omits an entry (for example a deleted side).
+					vals = append(vals, name, description)
+				case 1:
+					vals = append(vals, candidates[0], description)
+				default:
+					// Several real paths can have the same padded display.
+					// Ask JJ about each exact path instead of guessing which
+					// of them is conflicted.
+					for _, path := range candidates {
+						if checked[path] {
+							continue
+						}
+						checked[path] = true
+						path := path
+						batch = append(batch, carapace.ActionExecCommandE("jj", "--color=never", "resolve", "--list", "--revision", revision, "--", path)(func(selected []byte, err error) carapace.Action {
+							if err != nil {
+								if exit, ok := err.(*exec.ExitError); ok && exit.ExitCode() == 2 && strings.Contains(strings.ToLower(string(exit.Stderr)), "no conflicts") {
+									return carapace.ActionValues()
+								}
+								return carapace.ActionMessage(err.Error())
+							}
+							line := strings.TrimSuffix(string(selected), "\n")
+							if line == "" {
+								return carapace.ActionValues()
+							}
+							index := strings.LastIndex(line, "    ")
+							if index < 0 {
+								return carapace.ActionMessage("cannot parse jj conflict listing")
+							}
+							return carapace.ActionValuesDescribed(path, line[index+4:])
+						}))
+					}
+				}
+			}
+			return append(batch, carapace.ActionValuesDescribed(vals...)).ToA()
+		})
+	})
+}
diff --git a/pkg/actions/tools/jj/diff.go b/pkg/actions/tools/jj/diff.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f8cc8f079b2c913837655be4095d18fb2e70ad1
--- /dev/null
+++ b/pkg/actions/tools/jj/diff.go
@@ -0,0 +1,70 @@
+package jj
+
+import (
+	"strings"
+
+	"github.com/rsteube/carapace"
+	"github.com/rsteube/carapace/pkg/style"
+)
+
+// ActionRevDiffs completes changes beetween revisions
+// Accepts up to two revisions
+//
+//	0: compare current workspace to parent revision
+//	1: compare current workspace to given revision
+//	2: compare first revision to second revision
+func ActionRevDiffs(revisions ...string) carapace.Action {
+	return carapace.ActionCallback(func(c carapace.Context) carapace.Action {
+		var from, to string
+		switch len(revisions) {
+		case 0:
+			from = "@"
+			to = "@-"
+		case 1:
+			from = revisions[0]
+			to = revisions[0] + "-"
+		case 2:
+			from = revisions[0]
+			to = revisions[1]
+		default:
+			return carapace.ActionMessage("invalid amount of args [ActionRevChanges]")
+		}
+
+		return carapace.ActionExecCommand("jj", "--color=never", "diff", "--summary", "--from", from, "--to", to)(func(output []byte) carapace.Action {
+			lines := strings.Split(string(output), "\n")
+
+			vals := make([]string, 0)
+			for _, line := range lines[:len(lines)-1] {
+				if splitted := strings.SplitN(line, " ", 2); splitted != nil {
+					vals = append(vals, splitted[1], splitted[0])
+				}
+			}
+			a := carapace.ActionValuesDescribed(vals...)
+			if len(revisions) > 1 {
+				a = a.MultiParts("/")
+			}
+			return a.StyleF(style.ForPathExt)
+		})
+	})
+}
+
+// ActionRevChanges completes changes made in given revisions
+func ActionRevChanges(revisions ...string) carapace.Action {
+	return carapace.ActionCallback(func(c carapace.Context) carapace.Action {
+		args := []string{"log", "--summary", "--no-graph", "--template", ""}
+		for _, revision := range revisions {
+			args = append(args, "--revisions", revision)
+		}
+		return carapace.ActionExecCommand("jj", append([]string{"--color=never"}, args...)...)(func(output []byte) carapace.Action {
+			lines := strings.Split(string(output), "\n")
+
+			vals := make([]string, 0)
+			for _, line := range lines[:len(lines)-1] {
+				if splitted := strings.SplitN(line, " ", 2); splitted != nil {
+					vals = append(vals, splitted[1], splitted[0]) // TODO state isn't always correct (will be overwritten)
+				}
+			}
+			return carapace.ActionValuesDescribed(vals...).MultiParts("/").StyleF(style.ForPathExt)
+		})
+	})
+}
