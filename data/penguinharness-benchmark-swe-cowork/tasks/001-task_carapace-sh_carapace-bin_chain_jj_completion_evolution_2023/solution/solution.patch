diff --git a/pkg/actions/tools/jj/branch.go b/pkg/actions/tools/jj/branch.go
new file mode 100644
index 0000000000000000000000000000000000000000..588000bd17fd23948fa26103014c002e765892bf
--- /dev/null
+++ b/pkg/actions/tools/jj/branch.go
@@ -0,0 +1,68 @@
+package jj
+
+import (
+	"regexp"
+	"strings"
+
+	"github.com/rsteube/carapace"
+	"github.com/rsteube/carapace-bin/pkg/styles"
+)
+
+// ActionLocalBranches completes local branches
+//
+//	master (qvlkomxp 9a2e553b (empty) Merge pull request #939 from rsteube/docker-update-...)
+//	mdbook-linkcheck (numonpmw ad5c8efd mdbook: enable web-links)
+func ActionLocalBranches() carapace.Action {
+	return carapace.ActionExecCommand("jj", "--color=never", "branch", "list")(func(output []byte) carapace.Action {
+		lines := strings.Split(string(output), "\n")
+		r := regexp.MustCompile(`^(?P<branch>[^: ]+)[: ]+(?P<description>.*)$`)
+
+		vals := make([]string, 0)
+		for _, line := range lines[:len(lines)-1] {
+			if matches := r.FindStringSubmatch(line); matches != nil {
+				vals = append(vals, matches[1], matches[2])
+			}
+		}
+		return carapace.ActionValuesDescribed(vals...).Style(styles.Git.Branch)
+	}).Tag("local branches")
+}
+
+// ActionRemoteBranches completes remote branches
+//
+//	master@git (qvlkomxp 9a2e553b (empty) Merge pull request #939 from rsteube/docker-update-...)
+//	master@origin (qvlkomxp 9a2e553b (empty) Merge pull request #939 from rsteube/docker-update-...)
+func ActionRemoteBranches(remote string) carapace.Action {
+	return carapace.ActionExecCommand("jj", "--color=never", "branch", "list", "--all")(func(output []byte) carapace.Action {
+		lines := strings.Split(string(output), "\n")
+		r := regexp.MustCompile(`^(?P<branch>[^: ]+)[: ]+(?P<description>.*)$`)
+
+		vals := make([]string, 0)
+		branch := ""
+		for _, line := range lines[:len(lines)-1] {
+			switch {
+			case strings.HasPrefix(line, "  @"):
+				splitted := strings.SplitN(line, ": ", 2)
+				if len(splitted) != 2 {
+					continue
+				}
+				// Tracking status, such as "(behind by 1 commits)", is
+				// display metadata rather than part of the remote name.
+				name := strings.Fields(strings.TrimPrefix(splitted[0], "  @"))
+				if len(name) == 0 || (remote != "" && remote != name[0]) {
+					continue
+				}
+				description := splitted[1]
+				if fields := strings.SplitN(description, " ", 3); len(fields) == 3 {
+					description = fields[2]
+				}
+				vals = append(vals, branch+"@"+name[0], description)
+			case strings.HasPrefix(line, " "):
+			default:
+				if matches := r.FindStringSubmatch(line); matches != nil {
+					branch = matches[1]
+				}
+			}
+		}
+		return carapace.ActionValuesDescribed(vals...).Style(styles.Git.Branch)
+	}).Tag("remote branches")
+}
