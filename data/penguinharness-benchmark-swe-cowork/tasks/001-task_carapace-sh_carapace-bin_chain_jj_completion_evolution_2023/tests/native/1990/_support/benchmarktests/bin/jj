#!/usr/bin/env bash
set -Eeuo pipefail

args=" $* "

if [[ "$args" == *" git remote list "* ]]; then
    printf 'origin https://example.invalid/origin\nupstream https://example.invalid/upstream\n'
elif [[ "$args" == *" workspace list "* ]]; then
    printf 'default: qzzmpvmx current workspace\nreview: oxtpukyp review workspace\n'
elif [[ "$args" == *" op log "* ]]; then
    printf 'op0001\tinitialize repo\nop0002\tfetch origin\n'
elif [[ "$args" == *" resolve --list "* ]]; then
    printf 'conflict.txt    2-sided conflict\n'
elif [[ "$args" == *" config list "* ]]; then
    printf 'user.name=Example User\nui.editor=vim\n'
elif [[ "$args" == *" files "* ]]; then
    printf 'README.md\nsrc/main.go\n'
elif [[ "$args" == *" diff --summary "* ]]; then
    printf 'M src/main.go\nA docs/new.md\n'
elif [[ "$args" == *" log "* && "$args" == *" --summary "* ]]; then
    printf 'M src/main.go\nA docs/new.md\n'
elif [[ "$args" == *" branch list "* ]]; then
    printf 'main: abc1234 main branch\nfeature: def5678 feature branch\n  @origin: ghi9012 remote branch\n'
elif [[ "$args" == *" log "* && "$args" == *" tags() "* ]]; then
    printf 'v-test\ttagged release\n'
elif [[ "$args" == *" log "* && "$args" == *" ::@ "* ]]; then
    printf 'head000\tcurrent change\nhead001\tparent change\nhead002\tolder change\n'
elif [[ "$args" == *" log "* && "$args" == *" @-:: "* ]]; then
    printf 'next000\tcurrent change\nnext001\tchild change\nnext002\tnewer change\n'
elif [[ "$args" == *" log "* ]]; then
    printf 'recent001\nrecent change\nrecent002\nanother change\n'
else
    printf 'unsupported fake jj invocation: %s\n' "$*" >&2
    exit 64
fi
