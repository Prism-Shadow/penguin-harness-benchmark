new file mode 100644
index 00000000..af699b7c
--- /dev/null
+++ b/packages/mdx/lib/plugin/recma-stage-adapter.js
@@ -0,0 +1,100 @@
+/**
+ * @import {Program} from 'estree-jsx'
+ * @import {Options as BuildOptions} from 'estree-util-build-jsx'
+ * @import {Options as StringifyOptions} from 'estree-util-to-js'
+ * @import {Root} from 'hast'
+ * @import {Options as RehypeOptions} from 'hast-util-to-estree'
+ * @import {Processor, Plugin} from 'unified'
+ * @import {Node} from 'unist'
+ * @typedef {StringifyOptions & {plugins?: Array<ReturnType<typeof jsxPlugin>>}} RecmaSettings
+ * @import {VFile} from 'vfile'
+ */
+
+import {ok as assert} from 'devlop'
+import {buildJsx} from 'estree-util-build-jsx'
+import jsxPlugin from 'acorn-jsx'
+import {jsx as jsxHandlers, toJs} from 'estree-util-to-js'
+import {toEstree} from 'hast-util-to-estree'
+
+/**
+ * @param {Readonly<BuildOptions> | null | undefined} [options]
+ * @returns {(tree: Program, file: VFile) => undefined}
+ */
+export function recmaBuildJsx(options) {
+  return function (tree, file) {
+    let index = 0
+    while (index < tree.body.length) {
+      const child = tree.body[index]
+      if (child.type !== 'ExpressionStatement' || !('directive' in child)) break
+      index++
+    }
+    const directives = tree.body.splice(0, index)
+    buildJsx(tree, {filePath: file.history[0], ...options})
+    tree.body.unshift(...directives)
+  }
+}
+
+/**
+ * @this {Processor}
+ * @returns {undefined}
+ */
+export function recmaJsx() {
+  const data = this.data()
+  const settings = /** @type {RecmaSettings} */ (
+    data.settings || (data.settings = {})
+  )
+  const handlers = settings.handlers || (settings.handlers = {})
+  const plugins = settings.plugins || (settings.plugins = [])
+
+  plugins.push(jsxPlugin())
+  Object.assign(handlers, jsxHandlers)
+}
+
+/**
+ * @type {Plugin<[Readonly<StringifyOptions>?], Program, string>}
+ */
+export const recmaStringify = configureRecmaStringify
+
+/**
+ * @this {Processor}
+ * @param {Readonly<StringifyOptions> | null | undefined} [options]
+ * @returns {undefined}
+ */
+function configureRecmaStringify(options) {
+  const self = this
+  /**
+   * @param {Node} tree
+   * @param {VFile} file
+   * @returns {string}
+   */
+  const compiler = function (tree, file) {
+    assert(tree.type === 'Program', 'recma compiler requires an ESTree program')
+    assert('body' in tree && Array.isArray(tree.body))
+    const settings = {
+      .../** @type {StringifyOptions} */ (self.data('settings') || {}),
+      ...(options || {})
+    }
+    const result = toJs(/** @type {Program} */ (tree), {
+      SourceMapGenerator: settings.SourceMapGenerator,
+      filePath: file.path || 'unknown.js',
+      handlers: settings.handlers
+    })
+
+    file.map = result.map
+    return result.value
+  }
+
+  // Assignment through Object.assign avoids JSDoc treating this plugin as a
+  // constructor; the compiler's Node/VFile/string contract is checked above.
+  Object.assign(self, {compiler})
+}
+
+/**
+ * @param {Readonly<RehypeOptions> | null | undefined} [options]
+ * @returns {(tree: Root) => Program}
+ */
+export function rehypeRecma(options) {
+  return function (tree) {
+    return toEstree(tree, options)
+  }
+}
