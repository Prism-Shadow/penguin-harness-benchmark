<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0612;CS0618;CA1416</NoWarn>
    <BehaviorCasesPath Condition="'$(BehaviorCasesPath)' == ''">BehaviorCases.cs</BehaviorCasesPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="QRCoder"><HintPath>$(QRCoderAssembly)</HintPath></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="RunnerCompat.cs" />
    <Compile Include="BehaviorSupport.cs" />
    <Compile Include="$(BehaviorCasesPath)" Condition="Exists('$(BehaviorCasesPath)')" />
    <PackageReference Include="System.Drawing.Common" Version="5.0.3" />
  </ItemGroup>
</Project>
